doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Data Integration Platform
    // Font Awesome for icons
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    // Google Fonts - Inter and JetBrains Mono
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap")
    // Core styles
    style.
      :root {
        /* Colors - Light Theme */
        --brand-primary: #0072F5;
        --brand-primary-hover: #0065d8;
        --brand-primary-bg: rgba(0, 114, 245, 0.1);
        --brand-secondary: #7828C8;
        --brand-secondary-bg: rgba(120, 40, 200, 0.1);
        --brand-accent: #FF8A65;
        --brand-accent-bg: rgba(255, 138, 101, 0.1);
        
        --text-primary: #11181C;
        --text-secondary: #374151;
        --text-tertiary: #687076;
        --text-disabled: #9CA3AF;
        --text-inverse: #FFFFFF;
        
        --surface-body: #F8F9FB;
        --surface-card: #FFFFFF;
        --surface-overlay: rgba(255, 255, 255, 0.9);
        --surface-nav: #F1F5F9;
        --surface-nav-hover: #E2E8F0;
        --surface-nav-active: rgba(0, 114, 245, 0.15);
        --surface-code: #FAFAFA;
        --surface-table-header: #F9FAFB;
        
        --border-light: #EAECF0;
        --border-medium: #D1D5DB;
        --border-heavy: #9CA3AF;
        
        --error: #F31260;
        --warning: #F5A524;
        --success: #17C964;
        --info: #0070F3;
        
        /* Typography */
        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        --font-size-xs: 0.75rem;
        --font-size-sm: 0.875rem;
        --font-size-md: 1rem;
        --font-size-lg: 1.125rem;
        --font-size-xl: 1.25rem;
        --font-size-2xl: 1.5rem;
        --font-size-3xl: 1.875rem;
        
        /* Spacing */
        --space-1: 0.25rem;
        --space-2: 0.5rem;
        --space-3: 0.75rem;
        --space-4: 1rem;
        --space-5: 1.5rem;
        --space-6: 2rem;
        --space-8: 3rem;
        --space-10: 4rem;
        --space-12: 5rem;
        
        /* Border Radius */
        --radius-sm: 0.25rem;
        --radius-md: 0.375rem;
        --radius-lg: 0.5rem;
        --radius-xl: 0.75rem;
        --radius-full: 9999px;
        
        /* Shadows */
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        
        /* Transitions */
        --transition-fast: 150ms ease;
        --transition-normal: 300ms ease;
        --transition-slow: 500ms ease;
      }

      [data-theme="dark"] {
        --brand-primary: #3694FF;
        --brand-primary-hover: #5FA9FF;
        --brand-primary-bg: rgba(54, 148, 255, 0.2);
        --brand-secondary: #9353D3;
        --brand-secondary-bg: rgba(147, 83, 211, 0.2);
        --brand-accent: #FF9F7B;
        --brand-accent-bg: rgba(255, 159, 123, 0.2);

        --text-primary: #ECEDEE;
        --text-secondary: #B1B5C3;
        --text-tertiary: #889096;
        --text-disabled: #596068;
        --text-inverse: #0F1114;
        
        --surface-body: #151718;
        --surface-card: #1E2022;
        --surface-overlay: rgba(30, 32, 34, 0.95);
        --surface-nav: #1A1C1E;
        --surface-nav-hover: #26282C;
        --surface-nav-active: rgba(54, 148, 255, 0.25);
        --surface-code: #1A1C1E;
        --surface-table-header: #1A1C1E;
        
        --border-light: #2C2F34;
        --border-medium: #3E4248;
        --border-heavy: #525864;
        
        --error: #F21361;
        --warning: #F5A524;
        --success: #0AC864;
        --info: #0D8CFF;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      html, body {
        font-family: var(--font-sans);
        background-color: var(--surface-body);
        color: var(--text-primary);
        font-size: 16px;
        line-height: 1.5;
        height: 100%;
      }
      
      .app {
        display: flex;
        min-height: 100vh;
      }
      
      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: 250px;
        background-color: var(--surface-nav);
        border-right: 1px solid var(--border-light);
        z-index: 100;
        transition: transform var(--transition-normal);
      }
      
      .sidebar-header {
        height: 64px;
        display: flex;
        align-items: center;
        padding: 0 var(--space-4);
        border-bottom: 1px solid var(--border-light);
      }
      
      .logo {
        display: flex;
        align-items: center;
        color: var(--text-primary);
        text-decoration: none;
        font-weight: 600;
        font-size: var(--font-size-lg);
        gap: var(--space-2);
      }
      
      .logo-icon {
        color: var(--brand-primary);
        font-size: 1.5rem;
      }
      
      .nav {
        padding: var(--space-4) 0;
      }
      
      .nav-section {
        margin-bottom: var(--space-4);
      }
      
      .nav-section-title {
        padding: 0 var(--space-4);
        margin-bottom: var (--space-2);
        font-size: var(--font-size-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-tertiary);
      }
      
      .nav-list {
        list-style-type: none;
      }
      
      .nav-item {
        margin: var(--space-1) 0;
      }
      
      .nav-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3) var(--space-4);
        color: var(--text-secondary);
        text-decoration: none;
        font-weight: 500;
        border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
        transition: all var(--transition-fast);
      }
      
      .nav-link:hover {
        color: var(--text-primary);
        background-color: var(--surface-nav-hover);
      }
      
      .nav-link.active {
        color: var(--brand-primary);
        background-color: var(--surface-nav-active);
        font-weight: 600;
      }
      
      .nav-link-icon {
        font-size: var(--font-size-lg);
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .sidebar-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: var(--space-4);
        border-top: 1px solid var(--border-light);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      
      .theme-switcher {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-2) var(--space-3);
        background-color: var(--surface-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
      }
      
      .theme-switcher-label {
        font-size: var(--font-size-sm);
        font-weight: 500;
        color: var(--text-secondary);
      }
      
      .theme-switch {
        position: relative;
        width: 36px;
        height: 20px;
      }
      
      .theme-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      
      .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: var(--border-medium);
        border-radius: var(--radius-full);
        transition: var(--transition-fast);
      }
      
      .slider:before {
        position: absolute;
        content: "";
        height: 16px;
        width: 16px;
        left: 2px;
        bottom: 2px;
        background-color: white;
        border-radius: 50%;
        transition: var(--transition-fast);
      }
      
      input:checked + .slider {
        background-color: var(--brand-primary);
      }
      
      input:checked + .slider:before {
        transform: translateX(16px);
      }
      
      .user-info {
        display: flex;
        align-items: center;
        padding: var(--space-2);
        background-color: var(--surface-card);
        border: 1px solid var(--border-light);
        border-radius: var(--radius-md);
        gap: var(--space-3);
      }
      
      .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: var(--radius-full);
        background-color: var(--brand-primary-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: var(--brand-primary);
        font-size: var(--font-size-sm);
      }
      
      .user-details {
        flex: 1;
        min-width: 0;
      }
      
      .user-name {
        font-weight: 600;
        font-size: var(--font-size-sm);
        color: var(--text-secondary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      
      .user-role {
        font-size: var(--font-size-xs);
        color: var(--text-tertiary);
      }
      
      .main-content {
        flex: 1;
        margin-left: 250px;
        padding: var(--space-6);
        max-width: 100%;
        transition: margin-left var(--transition-normal);
      }
      
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-6);
      }
      
      .menu-toggle {
        display: none;
        background: none;
        border: none;
        font-size: var(--font-size-xl);
        color: var(--text-primary);
        cursor: pointer;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
      }
      
      .menu-toggle:hover {
        background-color: var(--surface-nav-hover);
      }
      
      .header-actions {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }
      
      .header-search {
        position: relative;
      }
      
      .search-container {
        position: relative;
        width: 250px;
      }
      
      .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }
      
      .search-icon {
        position: absolute;
        left: var(--space-3);
        color: var(--text-tertiary);
        pointer-events: none;
      }
      
      .search-input {
        width: 100%;
        padding: var(--space-2) var(--space-2) var(--space-2) calc(var(--space-2) + 24px);
        border-radius: var(--radius-md);
        border: 1px solid var(--border-medium);
        background-color: var(--surface-card);
        font-size: var(--font-size-sm);
        color: var(--text-primary);
      }
      
      .search-input:focus {
        outline: none;
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 2px var(--brand-primary-bg);
      }
      
      .header-button {
        width: 40px;
        height: 40px;
        border-radius: var(--radius-md);
        background-color: var(--surface-card);
        border: 1px solid var(--border-light);
        color: var(--text-tertiary);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--transition-fast);
      }
      
      .header-button:hover {
        color: var(--text-primary);
        border-color: var(--border-medium);
      }
      
      .header-button.has-badge {
        position: relative;
      }
      
      .badge {
        position: absolute;
        top: -4px;
        right: -4px;
        width: 16px;
        height: 16px;
        border-radius: var(--radius-full);
        background-color: var (--error);
        color: var(--text-inverse);
        font-size: 10px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid var(--surface-body);
      }
      
      .page-header {
        margin-bottom: var(--space-6);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4);
      }
      
      .page-title-wrapper {
        flex: 1;
      }
      
      .page-title {
        font-size: var(--font-size-2xl);
        font-weight: 600;
        line-height: 1.2;
        margin: 0;
        color: var(--text-primary);
      }
      
      .page-description {
        margin-top: var(--space-2);
        color: var(--text-tertiary);
      }
      
      .page-actions {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      
      .btn {
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-md);
        font-weight: 500;
        font-size: var(--font-size-sm);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all var(--transition-fast);
        text-decoration: none;
      }
      
      .btn-sm {
        padding: var(--space-1) var(--space-2);
        font-size: var(--font-size-xs);
      }
      
      .btn-primary {
        background-color: var(--brand-primary);
        color: var(--text-inverse);
        border: none;
      }
      
      .btn-primary:hover {
        background-color: var(--brand-primary-hover);
      }
      
      .btn-secondary {
        background-color: var(--brand-secondary);
        color: var(--text-inverse);
        border: none;
      }
      
      .btn-secondary:hover {
        background-color: var (--brand-secondary-hover);
      }
      
      .btn-accent {
        background-color: var(--brand-accent);
        color: var(--text-inverse);
        border: none;
      }
      
      .btn-accent:hover {
        background-color: var(--brand-accent-hover);
      }
      
      .btn-outline {
        background-color: transparent;
        color: var(--text-secondary);
        border: 1px solid var(--border-medium);
      }
      
      .btn-outline:hover {
        background-color: var(--surface-nav-hover);
        border-color: var(--border-heavy);
        color: var(--text-primary);
      }
      
      .btn-with-icon {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
      }
      
      .btn-with-icon i {
        font-size: var(--font-size-sm);
      }
      
      @media (max-width: 768px) {
        .sidebar {
          transform: translateX(-100%);
          box-shadow: var(--shadow-lg);
        }
        
        .sidebar.active {
          transform: translateX(0);
        }
        
        .main-content {
          margin-left: 0;
          padding: var(--space-4);
        }
        
        .menu-toggle {
          display: flex;
        }
      }
      
      /* Data visualizations */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: var(--space-4);
        margin-bottom: var(--space-6);
      }
      
      .stat-card {
        background-color: var(--surface-card);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        border: 1px solid var(--border-light);
      }
      
      .stat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-2);
      }
      
      .stat-title {
        font-size: var(--font-size-sm);
        font-weight: 600;
        color: var(--text-tertiary);
      }
      
      .stat-icon {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius-md);
        background-color: var(--brand-primary-bg);
        color: var(--brand-primary);
      }
      
      .stat-value {
        font-size: var(--font-size-2xl);
        font-weight: 600;
        color: var(--text-primary);
      }
      
      .stat-description {
        font-size: var(--font-size-xs);
        color: var(--text-tertiary);
      }
      
      /* Table styling */
      .data-table-container {
        overflow-x: auto;
        margin-bottom: var(--space-6);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-light);
        background-color: var(--surface-card);
      }
      
      table.data-table {
        width: 100%;
        border-collapse: collapse;
      }
      
      .data-table th {
        background-color: var(--surface-table-header);
        text-align: left;
        padding: var(--space-3);
        font-size: var(--font-size-sm);
        font-weight: 600;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-medium);
        position: sticky;
        top: 0;
      }
      
      .data-table td {
        padding: var(--space-3);
        border-bottom: 1px solid var(--border-light);
        font-size: var(--font-size-sm);
      }
      
      .data-table tbody tr:hover {
        background-color: var(--brand-primary-bg);
      }
      
      .data-table tbody tr:last-child td {
        border-bottom: none;
      }
      
      /* SQL Query Interface */
      .query-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        margin-bottom: var(--space-6);
      }
      
      .query-editor {
        font-family: var(--font-mono);
        padding: var(--space-3);
        border-radius: var(--radius-md);
        border: 1px solid var(--border-medium);
        background-color: var(--surface-code);
        color: var(--text-primary);
        min-height: 120px;
        width: 100%;
        resize: vertical;
        font-size: var(--font-size-sm);
      }
      
      .query-editor:focus {
        outline: none;
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 2px var(--brand-primary-bg);
      }
      
      .query-tools {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
        justify-content: space-between;
      }
      
      .query-options {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      
      .query-actions {
        display: flex;
        gap: var(--space-3);
      }
      
      .result-metadata {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-3);
        background-color: var(--surface-table-header);
        border-radius: var(--radius-md) var(--radius-md) 0 0;
        border: 1px solid var(--border-light);
        border-bottom: none;
      }
      
      .execution-time {
        font-size: var(--font-size-xs);
        color: var (--text-tertiary);
      }
      
      .row-count {
        font-size: var(--font-size-xs);
        color: var(--text-tertiary);
        font-weight: 600;
      }
      
      /* Card grid for source connections */
      .source-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: var(--space-4);
      }
      
      .source-card {
        background-color: var(--surface-card);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        border: 1px solid var(--border-light);
      }
      
      .source-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-3);
      }
      
      .source-title {
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      
      .source-status {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--font-size-sm);
      }
      
      .status-indicator {
        width: 8px;
        height: 8px;
        border-radius: var(--radius-full);
      }
      
      .status-online {
        background-color: var(--success);
      }
      
      .status-offline {
        background-color: var(--error);
      }
      
      .source-details {
        font-size: var(--font-size-sm);
        color: var(--text-secondary);
      }
      
      .source-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-3);
        margin-top: var(--space-3);
      }
      
      .source-stat {
        padding: var(--space-2);
        background-color: var(--surface-body);
        border-radius: var(--radius-md);
        text-align: center;
      }
      
      .source-stat-value {
        font-weight: 600;
        color: var(--text-primary);
      }
      
      .source-stat-label {
        font-size: var(--font-size-xs);
        color: var(--text-tertiary);
      }
    block styles

  body(data-theme="light")
    .app
      aside.sidebar
        .sidebar-header
          a.logo(href="/")
            span.logo-icon
              i.fas.fa-database
            span.logo-text Data Integration
      
        nav.nav
          .nav-section
            .nav-section-title Main
            ul.nav-list
              li.nav-item
                a.nav-link(href="/")
                  .nav-link-icon
                    i.fas.fa-home
                  | Dashboard
              li.nav-item
                a.nav-link(href="/sql-interface" class=currentPath === '/sql-interface' ? 'active' : '')
                  .nav-link-icon
                    i.fas.fa-code
                  | SQL Interface
              li.nav-item
                a.nav-link(href="/tables")
                  .nav-link-icon
                    i.fas.fa-table
                  | Data Tables
          
          
        
        .sidebar-footer
          .theme-switcher
            .theme-switcher-label Dark Mode
            label.theme-switch
              input#theme-toggle(type="checkbox")
              span.slider
          
          .user-info
            .user-avatar DI
            .user-details
              .user-name Integration System
              .user-role Admin
      
      main.main-content
        .header
          button.menu-toggle#menu-toggle
            i.fas.fa-bars
          
          .header-actions
            .header-search
              .search-container
                .search-input-wrapper
                  i.fas.fa-search.search-icon
                  input.search-input(type="text", placeholder="Search data...")

        block content

    script.
      // Theme toggle functionality
      const themeToggle = document.getElementById('theme-toggle');
      const body = document.body;
      
      if (localStorage.getItem('theme') === 'dark') {
        body.setAttribute('data-theme', 'dark');
        themeToggle.checked = true;
      }
      
      themeToggle.addEventListener('change', () => {
        if (themeToggle.checked) {
          body.setAttribute('data-theme', 'dark');
          localStorage.setItem('theme', 'dark');
        } else {
          body.setAttribute('data-theme', 'light');
          localStorage.setItem('theme', 'light');
        }
      });
      
      // Mobile menu toggle functionality
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.querySelector('.sidebar');
      
      menuToggle.addEventListener('click', () => {
        sidebar.classList.toggle('active');
      });
      
      // Close sidebar when clicking outside on mobile
      document.addEventListener('click', (e) => {
        if (window.innerWidth <= 768 && 
            sidebar.classList.contains('active') &&
            !sidebar.contains(e.target) && 
            e.target !== menuToggle) {
          sidebar.classList.remove('active');
        }
      });
      
      // Global search functionality
      const searchInput = document.querySelector('.search-input');
      if (searchInput) {
        searchInput.addEventListener('keyup', (e) => {
          if (e.key === 'Enter') {
            const query = searchInput.value.trim();
            if (query) {
              window.location.href = `/search?q=${encodeURIComponent(query)}`;
            }
          }
        });
      }
    
    block scripts