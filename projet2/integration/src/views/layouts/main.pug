doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title || "Data Integration System"
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    style.
      :root {
        --primary: #4361ee;
        --primary-dark: #3a56d4;
        --secondary: #3f8efc;
        --success: #2ec4b6;
        --danger: #e71d36;
        --warning: #ff9f1c;
        --light: #f8f9fa;
        --dark: #212529;
        --gray: #6c757d;
        --white: #ffffff;
        --card-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
      }
      
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      body {
        font-family: 'Segoe UI', Roboto, -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.6;
        color: var(--dark);
        background-color: #f5f8ff;
        margin: 0;
        padding: 0;
      }
      
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
      }
      
      h1, h2, h3, h4 {
        color: var(--dark);
        margin-bottom: 0.8rem;
        font-weight: 600;
      }
      
      h1 {
        font-size: 2.5rem;
        margin-bottom: 1.2rem;
        color: var(--primary-dark);
      }
      
      h2 {
        font-size: 1.8rem;
        color: var(--primary);
      }
      
      p {
        margin-bottom: 1rem;
        color: var(--gray);
      }
      
      .card {
        background-color: var(--white);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: var(--card-shadow);
        transition: var(--transition);
      }
      
      .card:hover {
        box-shadow: 0 10px 15px rgba(67, 97, 238, 0.1);
        transform: translateY(-3px);
      }
      
      .endpoints {
        margin-top: 2rem;
      }
      
      .endpoint-list {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
      }
      
      .endpoint-item {
        background-color: var(--white);
        padding: 1rem;
        border-radius: 8px;
        box-shadow: var(--card-shadow);
        border-left: 4px solid var(--primary);
        transition: var(--transition);
      }
      
      .endpoint-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
      }
      
      code {
        background-color: #f1f4ff;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        font-size: 0.9rem;
        color: var(--primary);
      }
      
      .sql-interface {
        background: linear-gradient(135deg, #4361ee 0%, #3a56d4 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: var(--card-shadow);
      }
      
      .sql-interface h2, .sql-interface p {
        color: var(--white);
      }
      
      .btn {
        display: inline-block;
        background-color: var(--white);
        color: var(--primary);
        text-decoration: none;
        padding: 0.8rem 1.5rem;
        border-radius: 6px;
        font-weight: 600;
        transition: var(--transition);
        border: none;
        cursor: pointer;
        text-align: center;
        margin-top: 1rem;
      }
      
      .btn:hover {
        background-color: rgba(255, 255, 255, 0.9);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      }
      
      .btn i {
        margin-right: 0.5rem;
      }
      
      .nav {
        background-color: var(--white);
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: var(--card-shadow);
      }
      
      .nav-brand {
        font-weight: 700;
        font-size: 1.5rem;
        color: var(--primary);
        text-decoration: none;
        display: flex;
        align-items: center;
      }
      
      .nav-brand i {
        margin-right: 0.5rem;
      }
      
      .nav-links {
        display: flex;
        gap: 1.5rem;
      }
      
      .nav-links a {
        color: var(--dark);
        text-decoration: none;
        font-weight: 500;
        transition: var(--transition);
        display: flex;
        align-items: center;
      }
      
      .nav-links a i {
        margin-right: 0.5rem;
      }
      
      .nav-links a:hover {
        color: var(--primary);
      }
      
      .header {
        text-align: center;
        margin-bottom: 2.5rem;
      }
      
      .header p {
        max-width: 600px;
        margin: 0 auto;
      }
      
      @media (max-width: 768px) {
        .container {
          padding: 15px;
        }
        
        .endpoint-list {
          grid-template-columns: 1fr;
        }
        
        .nav {
          flex-direction: column;
        }
        
        .nav-links {
          margin-top: 1rem;
          flex-wrap: wrap;
          justify-content: center;
        }
      }
  body
    .container
      include ../includes/navigation
      block content