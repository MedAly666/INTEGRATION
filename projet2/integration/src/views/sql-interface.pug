extends layouts/main

block content
  .chat-container
    .chat-header
      h1 
        i.fas.fa-database
        | SQL Query Interface
    
    .messages#messages
      .message.system
        .message-content
          p Welcome to the SQL query interface. You can execute SQL queries against our integrated database.
          p 
            strong Available tables: 
            span clients, employees, agences, fournisseurs, produits, commandes, details_commande, factures, livraisons, approvisionnement
      
      .message.system
        .message-content
          p Try one of these examples:
          .example-pills
            span.pill(onclick="setExampleQuery(1)") Show clients
            span.pill(onclick="setExampleQuery(2)") Find by name
            span.pill(onclick="setExampleQuery(3)") Join tables
            span.pill(onclick="setExampleQuery(4)") Count by category
            span.pill(onclick="setExampleQuery(5)") Top products

    .input-area
      textarea#query-input(placeholder="Type your SQL query here...", rows="1") SELECT * FROM clients LIMIT 10;
      button#execute-btn(onclick="executeQuery()")
        i.fas.fa-paper-plane
    
    .loading#loading
      .dot
      .dot
      .dot

  style.
    /* Use the theme variables that were defined in the main layout */
    /* Adjust the container to take full space */
    .container {
      padding: 10px 15px 0;
    }
    
    /* Make chat container take full height */
    .chat-container {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 80px);
      min-height: 500px;
      background-color: var(--card-bg);
      border-radius: 8px;
      box-shadow: var(--card-shadow);
      overflow: hidden;
      margin: 0 -10px; /* Negative margin to counteract container padding */
    }
    
    .chat-header {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      text-align: center;
    }
    
    .chat-header h1 {
      font-size: 1.5rem;
      margin: 0;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    
    .messages {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      background-color: var(--bg-color);
    }
    
    .message {
      display: flex;
      margin-bottom: 8px;
      max-width: 85%;
    }
    
    .message.system {
      align-self: flex-start;
    }
    
    .message.user {
      align-self: flex-end;
    }
    
    .message.result {
      align-self: flex-start;
      width: 100%;
      max-width: 100%;
    }
    
    .message-content {
      padding: 12px 16px;
      border-radius: 18px;
      font-size: 15px;
      line-height: 1.5;
    }
    
    .system .message-content {
      background-color: var(--hover-bg);
      color: var(--text-color);
      border-bottom-left-radius: 4px;
    }
    
    .user .message-content {
      background-color: var(--primary);
      color: white;
      border-bottom-right-radius: 4px;
    }
    
    .result .message-content {
      background-color: var(--hover-bg);
      color: var(--text-color);
      border-bottom-left-radius: 4px;
      width: 100%;
      overflow-x: auto;
    }
    
    .message-content p {
      margin: 0 0 8px 0;
      color: inherit;
    }
    
    .message-content p:last-child {
      margin-bottom: 0;
    }
    
    .input-area {
      display: flex;
      align-items: center;
      padding: 12px 16px;
      border-top: 1px solid var(--border-color);
      position: relative;
      background-color: var(--card-bg);
    }
    
    #query-input {
      flex: 1;
      padding: 12px 16px;
      padding-right: 48px;
      border: 1px solid var(--border-color);
      border-radius: 24px;
      font-size: 15px;
      resize: none;
      overflow-y: hidden;
      max-height: 150px;
      transition: height 0.1s;
      font-family: inherit;
      background-color: var(--bg-color);
      color: var(--text-color);
    }
    
    #query-input:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.1);
    }
    
    #query-input::placeholder {
      color: var(--gray);
    }
    
    #execute-btn {
      position: absolute;
      right: 28px;
      bottom: 24px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: transform 0.2s;
    }
    
    #execute-btn:hover {
      transform: scale(1.1);
    }
    
    .loading {
      display: none;
      justify-content: center;
      padding: 12px 0;
    }
    
    .loading .dot {
      width: 8px;
      height: 8px;
      background: var(--primary);
      border-radius: 50%;
      margin: 0 4px;
      animation: loadingAnimation 1.5s infinite ease-in-out;
    }
    
    .loading .dot:nth-child(2) {
      animation-delay: 0.2s;
    }
    
    .loading .dot:nth-child(3) {
      animation-delay: 0.4s;
    }
    
    @keyframes loadingAnimation {
      0%, 100% {
        transform: translateY(0);
        opacity: 0.4;
      }
      50% {
        transform: translateY(-8px);
        opacity: 1;
      }
    }
    
    .example-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    
    .pill {
      padding: 6px 12px;
      background-color: var(--hover-bg);
      color: var(--primary);
      border-radius: 16px;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    
    .pill:hover {
      background-color: var(--primary);
      color: white;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      font-size: 14px;
      text-align: left;
    }
    
    th {
      background-color: var(--table-header-bg);
      padding: 8px 12px;
      font-weight: 600;
      border-bottom: 2px solid rgba(67, 97, 238, 0.1);
    }
    
    td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--table-border);
    }
    
    tr:nth-child(even) {
      background-color: var(--hover-bg);
    }
    
    tr:hover {
      background-color: var(--table-row-hover);
    }
    
    .error {
      color: var(--danger);
      background-color: rgba(231, 29, 54, 0.1);
      padding: 8px 12px;
      border-left: 3px solid var(--danger);
      border-radius: 4px;
    }
    
    @media (max-width: 768px) {
      .chat-container {
        height: calc(100vh - 120px);
        margin: 0 -10px;
      }
      
      .example-pills {
        flex-wrap: wrap;
      }
      
      .message {
        max-width: 90%;
      }
    }
  
  script.
    // Auto-resize textarea
    const queryInput = document.getElementById('query-input');
    queryInput.addEventListener('input', function() {
      this.style.height = 'auto';
      this.style.height = (this.scrollHeight) + 'px';
    });
    
    // Set initial height
    window.addEventListener('load', function() {
      queryInput.style.height = 'auto';
      queryInput.style.height = (queryInput.scrollHeight) + 'px';
    });
    
    // Enter to submit (Shift+Enter for new line)
    queryInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        executeQuery();
      }
    });

    function executeQuery() {
      const query = document.getElementById('query-input').value;
      if (!query) {
        alert('Please enter a SQL query');
        return;
      }
      
      // Add user message
      const messagesDiv = document.getElementById('messages');
      const userMessage = document.createElement('div');
      userMessage.className = 'message user';
      userMessage.innerHTML = `<div class="message-content"><p>${query.replace(/\n/g, '<br>')}</p></div>`;
      messagesDiv.appendChild(userMessage);
      
      // Show loading indicator
      document.getElementById('loading').style.display = 'flex';
      
      // Clear input and resize
      queryInput.value = '';
      queryInput.style.height = 'auto';
      
      // Scroll to bottom
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
      
      // Send the query to the server
      fetch('/api/query', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ query })
      })
      .then(response => response.json())
      .then(data => {
        // Hide loading indicator
        document.getElementById('loading').style.display = 'none';

        // Create result message
        const resultMessage = document.createElement('div');
        resultMessage.className = 'message result';
        
        if (data.error) {
          resultMessage.innerHTML = `<div class="message-content"><div class="error">${data.error}</div></div>`;
        } else {
          resultMessage.innerHTML = createResultTable(data);
        }
        
        messagesDiv.appendChild(resultMessage);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
      })
      .catch(error => {
        document.getElementById('loading').style.display = 'none';
        
        const resultMessage = document.createElement('div');
        resultMessage.className = 'message result';
        resultMessage.innerHTML = `<div class="message-content"><div class="error">Error executing query: ${error}</div></div>`;
        
        messagesDiv.appendChild(resultMessage);
        messagesDiv.scrollTop = messagesDiv.scrollHeight;
      });
    }

    function createResultTable(data) {
      if (!data || data.length === 0) {
        return `<div class="message-content"><p>No results found.</p></div>`;
      }

      let html = `<div class="message-content"><p>Query executed successfully:</p><table>`;
      
      // Create header row
      html += `<tr>`;
      Object.keys(data[0]).forEach(key => {
        html += `<th>${key}</th>`;
      });
      html += `</tr>`;

      // Create data rows
      data.forEach(row => {
        html += `<tr>`;
        Object.values(row).forEach(value => {
          html += `<td>${value !== null ? value : 'NULL'}</td>`;
        });
        html += `</tr>`;
      });

      html += `</table></div>`;
      return html;
    }

    function setExampleQuery(exampleNumber) {
      const queryInput = document.getElementById('query-input');
      
      switch (exampleNumber) {
        case 1:
          queryInput.value = 'SELECT * FROM clients LIMIT 10;';
          break;
        case 2:
          queryInput.value = 'SELECT * FROM clients WHERE nom_complet LIKE "%Smith%";';
          break;
        case 3:
          queryInput.value = 'SELECT c.nom_complet, o.date_commande, o.statut\nFROM commandes o\nJOIN clients c ON o.client_ref = c.id\nLIMIT 10;';
          break;
        case 4:
          queryInput.value = 'SELECT categorie, COUNT(*) as product_count\nFROM produits\nGROUP BY categorie\nORDER BY product_count DESC;';
          break;
        case 5:
          queryInput.value = 'SELECT p.libelle, SUM(d.quantite) as total\nFROM details_commande d\nJOIN produits p ON d.produit_id = p.id\nGROUP BY p.libelle\nORDER BY total DESC\nLIMIT 5;';
          break;
      }
      
      // Update textarea height
      queryInput.style.height = 'auto';
      queryInput.style.height = (queryInput.scrollHeight) + 'px';
      queryInput.focus();
    }
    
    // Function to adjust height on window resize
    window.addEventListener('resize', function() {
      // Give time for the browser to update rendered dimensions
      setTimeout(function() {
        queryInput.style.height = 'auto';
        queryInput.style.height = (queryInput.scrollHeight) + 'px';
      }, 100);
    });