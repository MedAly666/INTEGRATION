    script.
      // Theme functionality
      const body = document.body;
      const themeToggleBtn = document.getElementById('theme-toggle-btn');
      
      // Set the theme based on localStorage
      if (localStorage.getItem('theme') === 'dark') {
        body.setAttribute('data-theme', 'dark');
      }
      
      // Handle theme toggle click
      if (themeToggleBtn) {
        themeToggleBtn.addEventListener('click', () => {
          const isDarkTheme = body.getAttribute('data-theme') === 'dark';
          if (isDarkTheme) {
            body.setAttribute('data-theme', 'light');
            localStorage.setItem('theme', 'light');
          } else {
            body.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
      
      // Mobile menu toggle functionality
      const menuToggle = document.getElementById('menu-toggle');
      if (menuToggle) {
        menuToggle.addEventListener('click', () => {
          const sidebar = document.querySelector('.sidebar');
          if (sidebar) {
            sidebar.classList.toggle('active');
          }
        });
      }
      
      // Global search functionality
      const searchInput = document.querySelector('.search-input');
      if (searchInput) {
        searchInput.addEventListener('keyup', (e) => {
          if (e.key === 'Enter') {
            const query = searchInput.value.trim();
            if (query) {
              window.location.href = `/search?q=${encodeURIComponent(query)}`;
            }
          }
        });
      }
    
    // Include external JavaScript files
    script(src="/public/js/sql-formatter.js")
    script(src="/public/js/sql-interface.js")
    

  
style.
  /* SQL Workspace Layout */
  .sql-workspace {
    display: flex;
    height: calc(100vh - 100px);
    min-height: 600px;
    background-color: var(--surface-body);
    border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      border: 1px solid var(--border-light);
    }
    
    /* Workspace Sidebar */
    .workspace-sidebar {
      width: 280px;
      background-color: var(--surface-card);
      border-right: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: width 0.3s ease;
    }
    
    .workspace-sidebar.collapsed {
      width: 50px;
    }
    
    .sidebar-section {
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid var(--border-light);
      overflow: hidden;
    }
    
    .sidebar-section:last-child {
      border-bottom: none;
      flex: 1;
    }
    
    .section-header {
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: var(--surface-table-header);
    }
    
    .section-header h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-secondary);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .section-header h3 i {
      color: var(--brand-primary);
    }
    
    .header-actions {
      display: flex;
      gap: 8px;
    }
    
    .btn-collapse, 
    .btn-clear-history {
      background: none;
      border: none;
      color: var(--text-tertiary);
      width: 24px;
      height: 24px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-collapse:hover, 
    .btn-clear-history:hover {
      color: var(--text-primary);
      background-color: var(--surface-nav-hover);
    }
    
    .section-content {
      padding: 12px;
      overflow-y: auto;
      flex: 1;
    }
    
    /* Schema Browser */
    .schema-search {
      position: relative;
      margin-bottom: 12px;
    }
    
    .schema-search input {
      width: 100%;
      padding: 8px 12px 8px 32px;
      border-radius: 6px;
      border: 1px solid var(--border-medium);
      background-color: var(--surface-body);
      color: var(--text-primary);
      font-size: 13px;
    }
    
    .schema-search input:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 2px var(--brand-primary-bg);
    }
    
    .schema-search i {
      position: absolute;
      left: 10px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
    }
    
    .schema-tree {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    
    .schema-category {
      border-radius: 6px;
      overflow: hidden;
    }
    
    .category-header {
      padding: 8px 12px;
      background-color: var(--surface-table-header);
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      border-radius: 6px;
      transition: all 0.2s ease;
    }
    
    .category-header:hover {
      background-color: var(--surface-nav-hover);
    }
    
    .category-header span {
      font-weight: 500;
      font-size: 13px;
      color: var(--text-secondary);
    }
    
    .category-header i {
      color: var(--text-tertiary);
      font-size: 12px;
      transition: transform 0.2s ease;
    }
    
    .category-items {
      display: flex;
      flex-direction: column;
      padding: 6px 0;
    }
    
    .category-items.collapsed {
      display: none;
    }
    
    .schema-item {
      padding: 6px 12px 6px 28px;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      border-radius: 4px;
      position: relative;
      transition: all 0.2s ease;
    }
    
    .schema-item:hover {
      background-color: var(--surface-nav-hover);
    }
    
    .schema-item span {
      font-size: 13px;
      color: var(--text-secondary);
      flex: 1;
    }
    
    .schema-item i.fa-table {
      color: var(--brand-primary);
      font-size: 12px;
    }
    
    .preview-icon {
      color: var(--text-tertiary);
      opacity: 0;
      transition: all 0.2s ease;
    }
    
    .schema-item:hover .preview-icon {
      opacity: 1;
    }
    
    .preview-icon:hover {
      color: var(--brand-primary);
    }
    
    /* Query History */
    .history-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .history-item {
      padding: 10px;
      border-radius: 6px;
      background-color: var(--surface-body);
      border: 1px solid var(--border-light);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .history-item:hover {
      border-color: var(--border-medium);
      transform: translateY(-1px);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    
    .history-item-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
    }
    
    .history-time {
      font-size: 11px;
      color: var(--text-tertiary);
    }
    
    .history-query {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    
    .history-meta {
      display: flex;
      justify-content: space-between;
      font-size: 11px;
      color: var(--text-tertiary);
      margin-top: 6px;
    }
    
    .empty-history, 
    .empty-queries {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      color: var(--text-tertiary);
      text-align: center;
    }
    
    .empty-icon {
      font-size: 24px;
      margin-bottom: 12px;
      opacity: 0.5;
    }
    
    /* Main Workspace */
    .workspace-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      background-color: var(--surface-body);
    }
    
    /* Query Panel */
    .query-panel {
      display: flex;
      flex-direction: column;
      height: 50%;
      min-height: 200px;
      border-bottom: 1px solid var(--border-light);
      overflow: hidden;
      resize: vertical;
    }
    
    .query-toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 12px;
      background-color: var(--surface-card);
      border-bottom: 1px solid var(--border-light);
      flex-wrap: wrap;
    }
    
    .toolbar-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .toolbar-right {
      margin-left: auto;
    }
    
    .btn-toolbar {
      height: 34px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      border-radius: 6px;
      background-color: var(--surface-body);
      border: 1px solid var(--border-medium);
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-toolbar:hover {
      border-color: var(--border-heavy);
      background-color: var(--surface-nav-hover);
    }
    
    .btn-toolbar:active {
      transform: translateY(1px);
    }
    
    .btn-toolbar i {
      font-size: 14px;
    }
    
    #btn-run {
      background-color: var(--brand-primary);
      color: white;
      border-color: var(--brand-primary);
    }
    
    #btn-run:hover {
      background-color: var(--brand-primary-hover);
      border-color: var(--brand-primary-hover);
    }
    
    #btn-stop {
      background-color: var(--error);
      color: white;
      border-color: var(--error);
    }
    
    #btn-stop:not(:disabled):hover {
      background-color: #e11d48;
      border-color: #e11d48;
    }
    
    #btn-stop:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .query-dropdown {
      height: 34px;
      padding: 0 12px;
      border-radius: 6px;
      background-color: var(--surface-body);
      border: 1px solid var(--border-medium);
      color: var(--text-secondary);
      font-size: 13px;
      min-width: 130px;
      cursor: pointer;
    }
    
    .query-dropdown:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 2px var(--brand-primary-bg);
    }
    
    .query-editor-container {
      flex: 1;
      display: flex;
      overflow: hidden;
      position: relative;
      background-color: var(--surface-code);
    }
    
    .editor-line-numbers {
      width: 50px;
      padding: 12px 0;
      background-color: var(--surface-table-header);
      border-right: 1px solid var(--border-light);
      text-align: center;
      font-family: var(--font-mono);
      font-size: 13px;
      color: var(--text-tertiary);
      user-select: none;
    }
    
    .query-editor {
      flex: 1;
      padding: 12px;
      font-family: var(--font-mono);
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-primary);
      white-space: pre;
      overflow: auto;
      outline: none;
    }
    
    /* Syntax highlighting classes */
    .query-editor .keyword {
      color: #9c27b0;
      font-weight: 600;
    }
    
    .query-editor .function {
      color: #2196f3;
    }
    
    .query-editor .table {
      color: #009688;
    }
    
    .query-editor .column {
      color: #ff5722;
    }
    
    .query-editor .number {
      color: #e91e63;
    }
    
    .query-editor .string {
      color: #4caf50;
    }
    
    .query-editor .comment {
      color: #9e9e9e;
      font-style: italic;
    }
    
    .query-status-bar {
      padding: 4px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background-color: var(--surface-table-header);
      border-top: 1px solid var(--border-light);
      font-size: 12px;
      color: var(--text-tertiary);
    }
    
    .keyboard-shortcuts {
      display: flex;
      gap: 12px;
    }
    
    .shortcut-item {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    
    .shortcut-item kbd {
      background-color: var(--surface-card);
      border: 1px solid var(--border-light);
      border-radius: 3px;
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 600;
      padding: 1px 4px;
      min-width: 16px;
      text-align: center;
      color: var(--text-secondary);
    }
    
    /* Results Panel */
    .results-panel {
      flex: 1;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    
    .results-tabs {
      display: flex;
      align-items: center;
      background-color: var(--surface-card);
      border-bottom: 1px solid var(--border-light);
      padding: 0 12px;
    }
    
    .tab {
      padding: 12px 16px;
      color: var(--text-tertiary);
      font-weight: 500;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
      border-bottom: 2px solid transparent;
    }
    
    .tab:hover {
      color: var(--text-secondary);
    }
    
    .tab.active {
      color: var(--brand-primary);
      border-bottom-color: var(--brand-primary);
    }
    
    .tabs-actions {
      margin-left: auto;
      display: flex;
      gap: 8px;
    }
    
    .btn-tab-action {
      height: 34px;
      padding: 0 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      border-radius: 6px;
      background-color: var(--surface-body);
      border: 1px solid var(--border-medium);
      color: var(--text-secondary);
      font-weight: 500;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-tab-action:hover {
      border-color: var(--border-heavy);
      background-color: var(--surface-nav-hover);
    }
    
    .results-container {
      flex: 1;
      position: relative;
      overflow: hidden;
    }
    
    .panel-content {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      overflow: auto;
      display: none;
      padding: 16px;
    }
    
    .panel-content.active {
      display: block;
    }
    
    .results-placeholder,
    .explain-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      text-align: center;
      color: var(--text-tertiary);
      padding: 0 16px;
    }
    
    .results-placeholder i,
    .explain-placeholder i {
      font-size: 48px;
      margin-bottom: 16px;
      opacity: 0.3;
    }
    
    .results-placeholder h3,
    .explain-placeholder h3 {
      margin: 0 0 8px;
      font-size: 18px;
      font-weight: 600;
      color: var(--text-secondary);
    }
    
    .results-placeholder p,
    .explain-placeholder p {
      font-size: 14px;
      max-width: 300px;
      margin: 0;
    }
    
    /* Results Table */
    .results-table-container {
      border-radius: 8px;
      border: 1px solid var(--border-light);
      overflow: hidden;
    }
    
    .results-info {
      display: flex;
      justify-content: space-between;
      padding: 12px 16px;
      background-color: var(--surface-table-header);
      font-size: 13px;
      color: var(--text-secondary);
    }
    
    .results-info-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    
    .results-info-item i {
      color: var(--brand-primary);
    }
    
    .results-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .results-table th {
      padding: 12px 16px;
      text-align: left;
      font-weight: 600;
      font-size: 13px;
      color: var(--text-secondary);
      background-color: var(--surface-table-header);
      border-bottom: 1px solid var(--border-medium);
      position: sticky;
      top: 0;
    }
    
    .results-table td {
      padding: 10px 16px;
      font-size: 13px;
      color: var(--text-primary);
      border-bottom: 1px solid var(--border-light);
      max-width: 300px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    
    .results-table tr:nth-child(even) {
      background-color: var(--surface-body);
    }
    
    .results-table tr:hover td {
      background-color: var(--brand-primary-bg);
    }
    
    /* Message List */
    .message-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .system-message {
      padding: 8px 12px;
      border-radius: 6px;
      font-size: 13px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }
    
    .info-message {
      background-color: var(--info-bg);
      color: var(--text-secondary);
    }
    
    .error-message {
      background-color: var(--error-bg);
      color: var(--error);
    }
    
    .success-message {
      background-color: var(--success-bg);
      color: var(--success);
    }
    
    .warning-message {
      background-color: var(--warning-bg);
      color: var(--warning);
    }
    
    .timestamp {
      color: var(--text-tertiary);
      font-size: 12px;
      min-width: 70px;
    }
    
    /* Modal */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      animation: fadeIn 0.2s ease;
    }
    
    .modal.visible {
      display: flex;
    }
    
    .modal-content {
      background-color: var(--surface-card);
      border-radius: 8px;
      width: 100%;
      max-width: 500px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
      overflow: hidden;
      animation: modalIn 0.3s ease;
    }
    
    .preview-content {
      max-width: 700px;
    }
    
    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid var(--border-light);
    }
    
    .modal-header h3 {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .btn-close {
      background: none;
      border: none;
      color: var(--text-tertiary);
      cursor: pointer;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .btn-close:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
    }
    
    .modal-body {
      padding: 20px;
      max-height: 70vh;
      overflow-y: auto;
    }
    
    .modal-footer {
      padding: 16px 20px;
      border-top: 1px solid var(--border-light);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      align-items: center;
    }
    
    .preview-info {
      color: var(--text-tertiary);
      font-size: 13px;
      margin-right: auto;
    }
    
    .form-group {
      margin-bottom: 16px;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      font-size: 14px;
      color: var(--text-secondary);
    }
    
    .form-group input, 
    .form-group textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid var(--border-medium);
      background-color: var(--surface-body);
      color: var(--text-primary);
      font-size: 14px;
    }
    
    .form-group textarea {
      min-height: 100px;
      resize: vertical;
    }
    
    .form-group input:focus, 
    .form-group textarea:focus {
      outline: none;
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 2px var(--brand-primary-bg);
    }
    
    .btn-primary {
      background-color: var(--brand-primary);
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-primary:hover {
      background-color: var(--brand-primary-hover);
    }
    
    .btn-secondary {
      background-color: var(--surface-nav);
      color: var(--text-secondary);
      border: 1px solid var(--border-medium);
      padding: 10px 16px;
      border-radius: 6px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .btn-secondary:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
    }
    
    .saved-queries-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    
    .saved-query-item {
      padding: 12px;
      border-radius: 6px;
      background-color: var(--surface-body);
      border: 1px solid var(--border-light);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    
    .saved-query-item:hover {
      border-color: var(--brand-primary);
      background-color: var(--brand-primary-bg);
    }
    
    .saved-query-name {
      font-weight: 600;
      font-size: 14px;
      color: var(--text-primary);
      margin-bottom: 4px;
    }
    
    .saved-query-description {
      font-size: 13px;
      color: var(--text-tertiary);
    }
    
    .saved-query-preview {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 8px;
      padding: 6px;
      background-color: var(--surface-code);
      border-radius: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    
    .table-preview-container {
      overflow: auto;
    }
    
    .preview-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px;
      color: var(--text-tertiary);
    }
    
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(0, 0, 0, 0.1);
      border-radius: 50%;
      border-top-color: var(--brand-primary);
      animation: spin 1s linear infinite;
      margin-bottom: 16px;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    @keyframes modalIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    /* Responsive Adjustments */
    @media (max-width: 992px) {
      .workspace-sidebar {
        width: 250px;
      }
      
      .shortcut-item {
        display: none;
      }
      
      .shortcut-item:first-child {
        display: flex;
      }
    }
    
    @media (max-width: 768px) {
      .workspace-sidebar {
        position: absolute;
        height: 100%;
        z-index: 10;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
      }
      
      .workspace-sidebar.visible {
        transform: translateX(0);
      }
      
      .toolbar-group:not(:first-child) {
        display: none;
      }
      
      .toolbar-right {
        display: flex !important;
      }
      
      #btn-run span, 
      #btn-stop span,
      .btn-tab-action span {
        display: none;
      }
      
      .btn-toolbar, 
      .btn-tab-action {
        width: 34px;
        padding: 0;
        justify-content: center;
      }
    }
    
    /* Chat messages */
    .chat-message {
      display: flex;
      margin-bottom: 1.25rem;
      max-width: 85%;
      animation: fadeIn 0.3s ease-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .chat-message.user {
      align-self: flex-end;
    }
    
    .chat-message.system {
      align-self: flex-start;
    }
    
    .message-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      margin-right: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      flex-shrink: 0;
    }
    
    .message-avatar.user-avatar {
      background: linear-gradient(135deg, var(--brand-secondary), var(--brand-secondary-hover));
      color: white;
    }
    
    .message-avatar.system-avatar {
      background: linear-gradient(135deg, var(--brand-primary), var(--brand-primary-hover));
      color: white;
    }
    
    .chat-message.user .message-avatar {
      order: 1;
      margin-right: 0;
      margin-left: 0.75rem;
    }
    
    .message-content {
      background-color: var(--surface-card);
      border-radius: 12px;
      padding: 1rem;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border-light);
      max-width: 100%;
    }
    
    .chat-message.user .message-content {
      background-color: var(--brand-primary-bg);
      border-color: rgba(var(--brand-primary-rgb), 0.3);
      border-top-right-radius: 0;
    }
    
    .chat-message.system .message-content {
      border-top-left-radius: 0;
    }
    
    .message-text {
      white-space: pre-wrap;
      color: var(--text-primary);
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }
    
    .message-query {
      font-family: var(--font-mono);
      background-color: var(--surface-code);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      margin-bottom: 0.75rem;
      overflow-x: auto;
      color: var(--text-secondary);
      font-size: 0.85rem;
      border: 1px solid var(--border-light);
    }
    
    .message-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    
    .message-action-btn {
      font-size: 0.75rem;
      padding: 0.4rem 0.75rem;
      background-color: var(--surface-nav);
      border: 1px solid var(--border-light);
      border-radius: 6px;
      color: var(--text-tertiary);
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-weight: 500;
    }
    
    .message-action-btn:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
      border-color: var(--border-medium);
    }
    
    /* Query results in chat */
    .result-container {
      margin-top: 0.75rem;
      max-width: 100%;
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--border-light);
    }
    
    .result-info {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0.75rem;
      background-color: var(--surface-table-header);
      font-size: 0.75rem;
      color: var(--text-tertiary);
      border-bottom: 1px solid var(--border-light);
      font-weight: 500;
    }
    
    .result-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }
    
    .result-table th {
      background-color: var(--surface-table-header);
      text-align: left;
      padding: 0.75rem;
      border-bottom: 1px solid var(--border-medium);
      font-weight: 600;
      color: var(--text-secondary);
      white-space: nowrap;
      position: sticky;
      top: 0;
    }
    
    .result-table td {
      padding: 0.75rem;
      border-bottom: 1px solid var(--border-light);
      color: var(--text-secondary);
    }
    
    .result-table tr:nth-child(even) {
      background-color: var(--surface-code);
    }
    
    .result-table tr:hover td {
      background-color: var(--brand-primary-bg);
    }
    
    .result-message {
      color: var(--text-secondary);
      font-style: italic;
      margin-top: var(--space-2);
    }
    
    .result-error {
      color: var(--error);
      background-color: var(--error-bg);
      padding: var(--space-3);
      border-radius: var(--radius-md);
      border-left: 4px solid var(--error);
      margin-top: var(--space-2);
    }
    
    /* Query input area */
    .query-controls {
      border-top: 1px solid var(--border-light);
      background-color: var(--surface-card);
      padding: var(--space-3);
    }
    
    .query-options {
      display: flex;
      gap: var(--space-4);
      margin-bottom: var(--space-3);
    }
    
    .option-label {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      font-weight: 500;
      margin-right: var(--space-2);
    }
    
    .option-select {
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      font-size: var(--font-size-sm);
      color: var(--text-primary);
    }
    
    .chat-input-area {
      display: flex;
      gap: var(--space-3);
    }
    
    .template-select-wrapper {
      position: relative;
      max-width: 140px;
    }
    
    .template-select {
      width: 100%;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      font-size: var(--font-size-sm);
      color: var(--text-primary);
      appearance: none;
      padding-right: 30px;
      cursor: pointer;
    }
    
    .template-select-wrapper::after {
      content: '\f078';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 12px;
      color: var(--text-tertiary);
    }
    
    .chat-input-wrapper {
      display: flex;
      flex: 1;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      overflow: hidden;
      background-color: var(--surface-card);
      transition: all var(--transition-fast);
    }
    
    .chat-input-wrapper:focus-within {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 2px var(--brand-primary-bg);
    }
    
    .chat-input {
      flex: 1;
      border: none;
      padding: var(--space-3);
      resize: none;
      background: transparent;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      line-height: 1.5;
      max-height: 150px;
      outline: none;
    }
    
    .chat-send-btn {
      background-color: transparent;
      border: none;
      width: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-tertiary);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    
    .chat-send-btn:hover {
      color: var(--brand-primary);
    }
    
    /* Typing indicator */
    .typing-indicator {
      display: flex;
      align-items: center;
      padding: var(--space-3);
      max-width: 100px;
      margin-bottom: var(--space-3);
    }
    
    .typing-dot {
      width: 8px;
      height: 8px;
      border-radius: var(--radius-full);
      background-color: var(--text-tertiary);
      margin-right: 4px;
      animation: typingBounce 1.2s infinite ease-in-out;
    }
    
    .typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }
    
    .typing-dot:nth-child(3) {
      animation-delay: 0.4s;
      margin-right: 0;
    }
    
    @keyframes typingBounce {
      0%, 60%, 100% { transform: translateY(0); }
      30% { transform: translateY(-4px); }
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .query-options {
        flex-wrap: wrap;
      }
      
      .chat-input-area {
        flex-direction: column;
      }
      
      .template-select-wrapper {
        max-width: none;
        width: 100%;
      }
      
      .chat-message {
        max-width: 95%;
      }
    }