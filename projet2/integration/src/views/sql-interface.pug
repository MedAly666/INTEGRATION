extends layouts/main

block content
  .page-header
    .page-title-wrapper
      h1.page-title SQL Chat
      p.page-description Interactive SQL querying in a conversational interface
    
    .page-actions
      button.btn.btn-outline.btn-with-icon#btn-clear-chat(type="button")
        i.fas.fa-broom
        | Clear Chat
      button.btn.btn-outline.btn-with-icon#btn-export-history(type="button")
        i.fas.fa-download
        | Export History

  .sql-chat-container
    .chat-area#chat-area
      .chat-welcome
        .chat-welcome-icon
          i.fas.fa-database
        h3.chat-welcome-title Welcome to SQL Chat
        p.chat-welcome-message Ask questions or run SQL queries against your integrated data sources
        .chat-welcome-examples
          h4 Try these examples:
          .example-queries
            button.example-query SELECT * FROM clients LIMIT 15;
            button.example-query SELECT COUNT(*) FROM commandes;
            button.example-query SELECT c.nom_complet, COUNT(o.id) as total_commandes FROM Clients c LEFT JOIN Commandes o ON c.id = o.client_ref GROUP BY c.id, c.nom_complet ORDER BY total_commandes DESC LIMIT 15;
    
    .query-controls
      .query-options
        .query-option
          label.option-label(for="chat-data-source") Data Source:
          select#chat-data-source.option-select
            option(value="all") All Sources
            option(value="sql") SQL Database
            option(value="xml") XML Store
            option(value="neo4j") Neo4j Graph
        
        .query-option
          label.option-label(for="chat-result-limit") Result Limit:
          select#chat-result-limit.option-select
            option(value="100") 100 rows
            option(value="500") 500 rows
            option(value="1000") 1000 rows
            option(value="5000") 5000 rows
      
      .chat-input-area
        .template-select-wrapper
          select.template-select#chat-query-template
            option(value="") Templates...
            option(value="select-clients") Select clients
            option(value="select-employees") Select employees
            option(value="select-orders") Select orders
            option(value="join-orders-clients") Join orders with clients
            option(value="count-by-client") Count orders by client
            option(value="product-inventory") Product inventory
            option(value="clients-with-no-orders") Clients without orders
            option(value="top-products-by-orders") Top products by orders
            option(value="recent-invoices") Recent invoices
            option(value="pending-deliveries") Pending deliveries
            option(value="suppliers-and-products") Suppliers and products
            option(value="complex-multi-join") Complex multi-table join
            option(value="average-order-value") Average order value
            option(value="employee-performance") Employee performance
        
        .chat-input-wrapper
          textarea#chat-input.chat-input(placeholder="Type your SQL query here...", rows="1")
          button#chat-send-btn.chat-send-btn(type="button")
            i.fas.fa-paper-plane

block append styles
  style.
    /* Chat UI Styles */
    .sql-chat-container {
      display: flex;
      flex-direction: column;
      height: calc(100vh - 220px);
      min-height: 500px;
      border-radius: var(--radius-lg);
      overflow: hidden;
      background-color: var(--surface-card);
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border-light);
    }
    
    .chat-area {
      flex: 1;
      overflow-y: auto;
      padding: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      background-color: var(--surface-background);
    }
    
    /* Welcome message */
    .chat-welcome {
      max-width: 600px;
      margin: auto;
      text-align: center;
      padding: var(--space-6);
    }
    
    .chat-welcome-icon {
      font-size: 3rem;
      margin-bottom: var(--space-4);
      color: var(--brand-primary);
    }
    
    .chat-welcome-title {
      font-size: var(--font-size-xl);
      font-weight: 600;
      margin-bottom: var(--space-3);
      color: var(--text-primary);
    }
    
    .chat-welcome-message {
      font-size: var(--font-size-md);
      margin-bottom: var(--space-5);
      color: var(--text-secondary);
    }
    
    .chat-welcome-examples {
      margin-top: var(--space-6);
    }
    
    .example-queries {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin-top: var(--space-3);
    }
    
    .example-query {
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      padding: var(--space-2) var(--space-3);
      background-color: var(--surface-code);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      cursor: pointer;
      text-align: left;
      color: var(--text-secondary);
      transition: all var(--transition-fast);
    }
    
    .example-query:hover {
      border-color: var(--brand-primary);
      background-color: var(--brand-primary-bg);
      color: var(--text-primary);
    }
    
    /* Chat messages */
    .chat-message {
      display: flex;
      margin-bottom: var(--space-3);
      max-width: 85%;
      animation: fadeIn 0.3s ease-out;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    .chat-message.user {
      align-self: flex-end;
    }
    
    .chat-message.system {
      align-self: flex-start;
    }
    
    .message-avatar {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-full);
      margin-right: var(--space-3);
      background-color: var(--brand-primary-bg);
      color: var(--brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
    }
    
    .chat-message.user .message-avatar {
      background-color: var(--brand-secondary-bg);
      color: var(--brand-secondary);
      order: 1;
      margin-right: 0;
      margin-left: var(--space-3);
    }
    
    .message-content {
      background-color: var(--surface-card);
      border-radius: var(--radius-lg);
      padding: var(--space-3);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-light);
      max-width: 100%;
    }
    
    .chat-message.user .message-content {
      background-color: var(--brand-primary-bg);
      border-color: var(--brand-primary-light);
      border-top-right-radius: 0;
    }
    
    .chat-message.system .message-content {
      border-top-left-radius: 0;
    }
    
    .message-text {
      white-space: pre-wrap;
      color: var(--text-primary);
      font-size: var(--font-size-sm);
      margin-bottom: var(--space-2);
    }
    
    .message-query {
      font-family: var(--font-mono);
      background-color: var(--surface-code);
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      margin-bottom: var(--space-2);
      overflow-x: auto;
      color: var(--text-secondary);
      font-size: var(--font-size-sm);
    }
    
    .message-actions {
      display: flex;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }
    
    .message-action-btn {
      font-size: var(--font-size-xs);
      padding: var(--space-1) var(--space-2);
      background-color: var(--surface-nav);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-md);
      color: var(--text-tertiary);
      cursor: pointer;
      transition: all var(--transition-fast);
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    
    .message-action-btn:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
      border-color: var(--border-medium);
    }
    
    /* Query results in chat */
    .result-container {
      margin-top: var(--space-2);
      max-width: 100%;
      overflow-x: auto;
    }
    
    .result-info {
      display: flex;
      justify-content: space-between;
      margin-bottom: var(--space-2);
      font-size: var(--font-size-xs);
      color: var(--text-tertiary);
    }
    
    .result-table {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--font-size-xs);
    }
    
    .result-table th {
      background-color: var(--surface-table-header);
      text-align: left;
      padding: var(--space-2);
      border-bottom: 1px solid var(--border-medium);
      font-weight: 600;
      color: var(--text-secondary);
      white-space: nowrap;
    }
    
    .result-table td {
      padding: var(--space-2);
      border-bottom: 1px solid var(--border-light);
      color: var (--text-secondary);
    }
    
    .result-table tr:nth-child(even) {
      background-color: var(--surface-code);
    }
    
    .result-table tr:hover td {
      background-color: var(--brand-primary-bg);
    }
    
    .result-message {
      color: var(--text-secondary);
      font-style: italic;
      margin-top: var(--space-2);
    }
    
    .result-error {
      color: var(--error);
      background-color: var(--error-bg);
      padding: var(--space-3);
      border-radius: var(--radius-md);
      border-left: 4px solid var(--error);
      margin-top: var(--space-2);
    }
    
    /* Query input area */
    .query-controls {
      border-top: 1px solid var(--border-light);
      background-color: var(--surface-card);
      padding: var(--space-3);
    }
    
    .query-options {
      display: flex;
      gap: var(--space-4);
      margin-bottom: var(--space-3);
    }
    
    .option-label {
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
      font-weight: 500;
      margin-right: var(--space-2);
    }
    
    .option-select {
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      font-size: var(--font-size-sm);
      color: var(--text-primary);
    }
    
    .chat-input-area {
      display: flex;
      gap: var(--space-3);
    }
    
    .template-select-wrapper {
      position: relative;
      max-width: 140px;
    }
    
    .template-select {
      width: 100%;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      font-size: var(--font-size-sm);
      color: var(--text-primary);
      appearance: none;
      padding-right: 30px;
      cursor: pointer;
    }
    
    .template-select-wrapper::after {
      content: '\f078';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      pointer-events: none;
      font-size: 12px;
      color: var(--text-tertiary);
    }
    
    .chat-input-wrapper {
      display: flex;
      flex: 1;
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      overflow: hidden;
      background-color: var(--surface-card);
      transition: all var(--transition-fast);
    }
    
    .chat-input-wrapper:focus-within {
      border-color: var(--brand-primary);
      box-shadow: 0 0 0 2px var(--brand-primary-bg);
    }
    
    .chat-input {
      flex: 1;
      border: none;
      padding: var(--space-3);
      resize: none;
      background: transparent;
      color: var(--text-primary);
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      line-height: 1.5;
      max-height: 150px;
      outline: none;
    }
    
    .chat-send-btn {
      background-color: transparent;
      border: none;
      width: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-tertiary);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    
    .chat-send-btn:hover {
      color: var(--brand-primary);
    }
    
    /* Typing indicator */
    .typing-indicator {
      display: flex;
      align-items: center;
      padding: var(--space-3);
      max-width: 100px;
      margin-bottom: var(--space-3);
    }
    
    .typing-dot {
      width: 8px;
      height: 8px;
      border-radius: var(--radius-full);
      background-color: var(--text-tertiary);
      margin-right: 4px;
      animation: typingBounce 1.2s infinite ease-in-out;
    }
    
    .typing-dot:nth-child(2) {
      animation-delay: 0.2s;
    }
    
    .typing-dot:nth-child(3) {
      animation-delay: 0.4s;
      margin-right: 0;
    }
    
    @keyframes typingBounce {
      0%, 60%, 100% { transform: translateY(0); }
      30% { transform: translateY(-4px); }
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .query-options {
        flex-wrap: wrap;
      }
      
      .chat-input-area {
        flex-direction: column;
      }
      
      .template-select-wrapper {
        max-width: none;
        width: 100%;
      }
      
      .chat-message {
        max-width: 95%;
      }
    }

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // DOM Elements
      const chatArea = document.getElementById('chat-area');
      const chatInput = document.getElementById('chat-input');
      const sendButton = document.getElementById('chat-send-btn');
      const clearChatButton = document.getElementById('btn-clear-chat');
      const exportHistoryButton = document.getElementById('btn-export-history');
      const queryTemplateSelect = document.getElementById('chat-query-template');
      const dataSourceSelect = document.getElementById('chat-data-source');
      const resultLimitSelect = document.getElementById('chat-result-limit');
      const exampleQueries = document.querySelectorAll('.example-query');
      
      // Chat history
      let chatHistory = [];
      
      // Auto-resize text input
      chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 150) + 'px';
      });
      
      // Send button click
      sendButton.addEventListener('click', () => {
        sendQuery();
      });
      
      // Enter key to send (Ctrl/Cmd + Enter)
      chatInput.addEventListener('keydown', (e) => {
        if ((e.key === 'Enter' && (e.ctrlKey || e.metaKey)) || 
            (e.key === 'Enter' && !e.shiftKey)) {
          e.preventDefault();
          sendQuery();
        }
      });
      
      // Clear chat button
      clearChatButton.addEventListener('click', () => {
        if (confirm('Are you sure you want to clear the chat history?')) {
          chatHistory = [];
          chatArea.innerHTML = '';
          addWelcomeMessage();
        }
      });
      
      // Export chat history
      exportHistoryButton.addEventListener('click', () => {
        if (chatHistory.length === 0) {
          alert('No chat history to export.');
          return;
        }
        
        const historyJSON = JSON.stringify(chatHistory, null, 2);
        const blob = new Blob([historyJSON], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `sql-chat-history-${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      });
      
      // Query templates
      const templates = {
        'select-clients': 'SELECT * FROM Clients LIMIT 10;',
        'select-employees': 'SELECT * FROM Employees LIMIT 10;',
        'select-orders': 'SELECT * FROM Commandes LIMIT 10;',
        'join-orders-clients': 'SELECT c.nom_complet, o.date_commande, o.montant\nFROM Clients c\nJOIN Commandes o ON c.id_client = o.client_ref\nORDER BY o.date_commande DESC\nLIMIT 15;',
        'count-by-client': 'SELECT c.nom_complet, COUNT(o.id_commande) as total_commandes FROM Clients c LEFT JOIN Commandes o ON c.id_client = o.client_ref GROUP BY c.id_client, c.nom_complet ORDER BY total_commandes DESC LIMIT 15;',
        'product-inventory': 'SELECT p.description, p.prix_cout, p.categorie\nFROM Produits p\nORDER BY p.description;',
        'clients-with-no-orders': 'SELECT c.nom_complet, c.email_contact, c.numero_telephone\nFROM Clients c\nLEFT JOIN Commandes o ON c.id_client = o.client_ref\nWHERE o.id_commande IS NULL;',
        'top-products-by-orders': 'SELECT p.description, COUNT(d.id_commande) as times_ordered, SUM(d.quantite) as total_quantity\nFROM Produits p\nJOIN Details_Commande d ON p.id_produit = d.id_produit\nGROUP BY p.id_produit, p.description\nORDER BY times_ordered DESC\nLIMIT 10;',
        'recent-invoices': 'SELECT f.id_facture, f.date_facture, c.nom_complet, f.montant_total\nFROM Factures f\nJOIN Commandes o ON f.commande_ref = o.id_commande\nJOIN Clients c ON o.client_ref = c.id_client\nORDER BY f.date_facture DESC\nLIMIT 15;',
        'pending-deliveries': 'SELECT l.id_livraison, l.data_estimee, c.nom_complet, l.transporteur, o.montant\nFROM Livraisons l\nJOIN Commandes o ON l.commande_ref = o.id_commande\nJOIN Clients c ON o.client_ref = c.id_client\nWHERE l.statut = \'en cours\'\nORDER BY l.data_estimee;',
        'suppliers-and-products': 'SELECT f.nom_fournisseur, p.description, a.quantite\nFROM Fournisseurs f\nJOIN Approvisionnement a ON f.id_fournisseur = a.id_fournisseur\nJOIN Produits p ON a.id_produit = p.id_produit\nORDER BY f.nom_fournisseur, p.description;',
        'complex-multi-join': 'SELECT c.nom_complet, o.id_commande, o.date_commande, p.description,\nd.quantite, f.id_facture, l.statut as statut_livraison\nFROM Clients c\nJOIN Commandes o ON c.id_client = o.client_ref\nJOIN Details_Commande d ON o.id_commande = d.id_commande\nJOIN Produits p ON d.id_produit = p.id_produit\nLEFT JOIN Factures f ON o.id_commande = f.commande_ref\nLEFT JOIN Livraisons l ON o.id_commande = l.commande_ref\nWHERE o.date_commande > \'2023-01-01\'\nORDER BY o.date_commande DESC\nLIMIT 20;',
        'average-order-value': 'SELECT SUBSTRING(o.date_commande, 1, 7) as month,\nAVG(o.montant) as average_order_value,\nCOUNT(o.id_commande) as order_count\nFROM Commandes o\nGROUP BY month\nORDER BY month DESC;',
        'employee-performance': 'SELECT e.nom_complet, COUNT(o.id_commande) as orders_processed,\nSUM(o.montant) as total_sales\nFROM Employees e\nJOIN Commandes o ON e.id_employe = o.employe_ref\nGROUP BY e.id_employe, e.nom_complet\nORDER BY total_sales DESC;'
      };
      
      // Query template selection
      queryTemplateSelect.addEventListener('change', (e) => {
        const template = templates[e.target.value];
        if (template) {
          chatInput.value = template;
          chatInput.style.height = 'auto';
          chatInput.style.height = Math.min(chatInput.scrollHeight, 150) + 'px';
          chatInput.focus();
        }
      });
      
      // Example queries
      exampleQueries.forEach(btn => {
        btn.addEventListener('click', () => {
          chatInput.value = btn.textContent.trim();
          chatInput.style.height = 'auto';
          chatInput.style.height = Math.min(chatInput.scrollHeight, 150) + 'px';
          chatInput.focus();
        });
      });
      
      // Add welcome message
      function addWelcomeMessage() {
        const welcomeHTML = `
          <div class="chat-welcome">
            <div class="chat-welcome-icon">
              <i class="fas.fa-database"></i>
            </div>
            <h3 class="chat-welcome-title">Welcome to SQL Chat</h3>
            <p class="chat-welcome-message">Ask questions or run SQL queries against your integrated data sources</p>
            <div class="chat-welcome-examples">
              <h4>Try these examples:</h4>
              <div class="example-queries">
                <button class="example-query">SELECT * FROM clients LIMIT 5;</button>
                <button class="example-query">SELECT COUNT(*) FROM commandes;</button>
                <button class="example-query">SELECT c.nom_complet, COUNT(o.id) as total_commandes FROM Clients c LEFT JOIN Commandes o ON c.id = o.client_ref GROUP BY c.id, c.nom_complet ORDER BY total_commandes DESC LIMIT 15;</button>
              </div>
            </div>
          </div>
        `;
        
        chatArea.innerHTML = welcomeHTML;
        
        // Re-attach event listeners to example queries
        document.querySelectorAll('.example-query').forEach(btn => {
          btn.addEventListener('click', () => {
            chatInput.value = btn.textContent.trim();
            chatInput.style.height = 'auto';
            chatInput.style.height = Math.min(chatInput.scrollHeight, 150) + 'px';
            chatInput.focus();
          });
        });
      }
      
      // Send query function
      function sendQuery() {
        const query = chatInput.value.trim();
        
        if (!query) {
          return;
        }
        
        // Add user message to chat
        addUserMessage(query);
        
        // Add to history
        chatHistory.push({
          type: 'user',
          query: query,
          timestamp: new Date().toISOString()
        });
        
        // Clear input
        chatInput.value = '';
        chatInput.style.height = 'auto';
        
        // Reset template select
        queryTemplateSelect.selectedIndex = 0;
        
        // Show typing indicator
        showTypingIndicator();
        
        // Get data source and limit
        const dataSource = dataSourceSelect.value;
        const limit = parseInt(resultLimitSelect.value);
        
        // Execute query
        executeQuery(query, dataSource, limit);
      }
      
      // Add user message to chat
      function addUserMessage(query) {
        // Remove welcome message if present
        const welcomeMessage = chatArea.querySelector('.chat-welcome');
        if (welcomeMessage) {
          chatArea.innerHTML = '';
        }
        
        const messageHTML = `
          <div class="chat-message user">
            <div class="message-content">
              <div class="message-text">You ran the following SQL query:</div>
              <div class="message-query">${escapeHTML(query)}</div>
            </div>
            <div class="message-avatar">
              <i class="fas fa-user"></i>
            </div>
          </div>
        `;
        
        chatArea.insertAdjacentHTML('beforeend', messageHTML);
        scrollToBottom();
      }
      
      // Add system message to chat
      function addSystemMessage(data, query, executionTime, error = null) {
        // Remove typing indicator
        const typingIndicator = chatArea.querySelector('.typing-indicator');
        if (typingIndicator) {
          typingIndicator.remove();
        }
        
        let resultHTML = '';
        
        if (error) {
          resultHTML = `<div class="result-error">${escapeHTML(error)}</div>`;
        } else if (!data || data.length === 0) {
          resultHTML = `<div class="result-message">The query returned no results.</div>`;
        } else {
          // Get column headers from first result
          const columns = Object.keys(data[0]);
          
          resultHTML = `
            <div class="result-container">
              <div class="result-info">
                <span>${data.length} ${data.length === 1 ? 'row' : 'rows'} returned</span>
                <span>Execution time: ${executionTime}ms</span>
              </div>
              <table class="result-table">
                <thead>
                  <tr>
                    ${columns.map(col => `<th>${escapeHTML(col)}</th>`).join('')}
                  </tr>
                </thead>
                <tbody>
          `;
          
          // Add rows (limit to 50 in the UI for performance)
          const displayLimit = Math.min(data.length, 50);
          
          for (let i = 0; i < displayLimit; i++) {
            const row = data[i];
            resultHTML += '<tr>';
            
            columns.forEach(column => {
              const value = row[column] !== null ? row[column] : '';
              resultHTML += `<td>${escapeHTML(String(value))}</td>`;
            });
            
            resultHTML += '</tr>';
          }
          
          // Add message if rows were limited
          if (displayLimit < data.length) {
            resultHTML += `
              <tr>
                <td colspan="${columns.length}" style="text-align: center; font-style: italic;">
                  ${data.length - displayLimit} more rows (limited display for performance)
                </td>
              </tr>
            `;
          }
          
          resultHTML += `
                </tbody>
              </table>
            </div>
          `;
        }
        
        const messageHTML = `
          <div class="chat-message system">
            <div class="message-avatar">
              <i class="fas fa-database"></i>
            </div>
            <div class="message-content">
              <div class="message-text">Query results:</div>
              ${resultHTML}
              <div class="message-actions">
                <button class="message-action-btn copy-query" data-query="${escapeHTML(query)}">
                  <i class="fas fa-copy"></i> Copy Query
                </button>
                <button class="message-action-btn rerun-query" data-query="${escapeHTML(query)}">
                  <i class="fas fa-redo-alt"></i> Run Again
                </button>
                ${!error && data && data.length > 0 ? `
                <button class="message-action-btn export-csv" data-index="${chatHistory.length}">
                  <i class="fas fa-file-csv"></i> Export CSV
                </button>` : ''}
              </div>
            </div>
          </div>
        `;
        
        chatArea.insertAdjacentHTML('beforeend', messageHTML);
        
        // Add to history
        chatHistory.push({
          type: 'system',
          query: query,
          result: error ? { error } : data,
          executionTime: executionTime,
          timestamp: new Date().toISOString()
        });
        
        // Add event listeners for message actions
        const copyButtons = document.querySelectorAll('.copy-query');
        const rerunButtons = document.querySelectorAll('.rerun-query');
        const exportButtons = document.querySelectorAll('.export-csv');
        
        copyButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const query = this.getAttribute('data-query');
            navigator.clipboard.writeText(query)
              .then(() => {
                this.innerHTML = '<i class="fas fa-check"></i> Copied!';
                setTimeout(() => {
                  this.innerHTML = '<i class="fas fa-copy"></i> Copy Query';
                }, 2000);
              });
          });
        });
        
        rerunButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const query = this.getAttribute('data-query');
            chatInput.value = query;
            chatInput.style.height = 'auto';
            chatInput.style.height = Math.min(chatInput.scrollHeight, 150) + 'px';
            chatInput.focus();
          });
        });
        
        exportButtons.forEach(btn => {
          btn.addEventListener('click', function() {
            const historyIndex = this.getAttribute('data-index');
            const result = chatHistory[historyIndex].result;
            exportAsCSV(result);
          });
        });
        
        scrollToBottom();
      }
      
      // Show typing indicator
      function showTypingIndicator() {
        const indicatorHTML = `
          <div class="chat-message system typing-indicator">
            <div class="message-avatar">
              <i class="fas fa-database"></i>
            </div>
            <div class="message-content">
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
              <div class="typing-dot"></div>
            </div>
          </div>
        `;
        
        chatArea.insertAdjacentHTML('beforeend', indicatorHTML);
        scrollToBottom();
      }
      
      // Execute query
      async function executeQuery(query, dataSource, limit) {
        const startTime = performance.now();
        
        try {
          // Send query to server
          const response = await fetch('/api/query', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              query,
              parameters: {
                dataSource,
                limit
              }
            })
          });
          
          const executionTime = Math.round(performance.now() - startTime);
          
          if (!response.ok) {
            const error = await response.json();
            addSystemMessage(null, query, executionTime, error.error || 'Unknown error occurred');
            return;
          }
          
          const data = await response.json();
          addSystemMessage(data, query, executionTime);
          
        } catch (error) {
          const executionTime = Math.round(performance.now() - startTime);
          addSystemMessage(null, query, executionTime, error.message || 'An error occurred while executing the query.');
        }
      }
      
      // Export as CSV function
      function exportAsCSV(data) {
        if (!data || !data.length) {
          alert('No data to export');
          return;
        }
        
        // Get column headers
        const columns = Object.keys(data[0]);
        
        // Create CSV header row
        const csvRows = [columns.map(col => `"${col}"`).join(',')];
        
        // Add data rows
        data.forEach(row => {
          const values = columns.map(col => {
            const val = row[col] !== null ? row[col] : '';
            return `"${String(val).replace(/"/g, '""')}"`;
          });
          csvRows.push(values.join(','));
        });
        
        // Download CSV
        const csvContent = csvRows.join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        
        const a = document.createElement('a');
        a.href = url;
        a.download = `query-result-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      }
      
      // Helper function to escape HTML
      function escapeHTML(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
      
      // Scroll to bottom function
      function scrollToBottom() {
        chatArea.scrollTop = chatArea.scrollHeight;
      }
      
      // Initialize with welcome message
      addWelcomeMessage();
    });