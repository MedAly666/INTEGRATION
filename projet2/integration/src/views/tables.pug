extends layouts/main

block content
  .page-header
    .page-title-wrapper
      h1.page-title Integrated Data Tables
      p.page-description Browse and explore data from all connected sources
    
    .page-actions
      button.btn.btn-outline.btn-with-icon#btn-refresh(type="button")
        i.fas.fa-sync-alt
        | Refresh Data

  // Table selection and filters
  .filter-container
    .filter-section
      label.filter-label(for="table-select") Select Table:
      select.filter-select#table-select
        option(value="clients") Clients
        option(value="employees") Employees
        option(value="agences") Agences
        option(value="commandes") Commandes
        option(value="details-commande") Details Commande
        option(value="produits") Produits
        option(value="fournisseurs") Fournisseurs
        option(value="factures") Factures
        option(value="livraisons") Livraisons
        option(value="approvisionnements") Approvisionnements
    
    .filter-section
      label.filter-label(for="data-source-select") Data Source:
      select.filter-select#data-source-select
        option(value="all") All Sources
        option(value="sql") SQL Database
        option(value="xml") XML Store
        option(value="neo4j") Neo4j Graph
    
    .filter-section-search
      .search-wrapper
        i.fas.fa-search.search-icon
        input.search-input#table-search(type="text" placeholder="Search in current table...")
        button.search-clear#search-clear(type="button")
          i.fas.fa-times

  .data-stats-container
    .data-stats
      .stat-item
        .stat-label Records:
        .stat-value#records-count 0
      .stat-item
        .stat-label Source:
        .stat-value#current-source All Sources
      .stat-item
        .stat-label Filter:
        .stat-value#filter-status None
    
    .data-actions
      button.btn.btn-sm.btn-outline.btn-with-icon#btn-export-table-csv(type="button")
        i.fas.fa-file-csv
        | Export CSV
      button.btn.btn-sm.btn-outline.btn-with-icon#btn-export-table-json(type="button")
        i.fas.fa-file-code
        | Export JSON

  // Data table with sticky header and pagination
  .data-table-container
    table.data-table#data-table
      thead
        tr
          th.loading-cell(colspan="5") Select a table to view data
      tbody
        tr
          td.loading-cell(colspan="5") 
            i.fas.fa-table
            | No data to display
  
  // Table pagination
  .table-pagination#table-pagination
    .pagination-info
      span Showing 
      span#pagination-showing 0
      span  of 
      span#pagination-total 0
      span  entries
    
    .pagination-controls
      button.btn.btn-sm.btn-outline.pagination-btn#pagination-first(disabled)
        i.fas.fa-angle-double-left
      
      button.btn.btn-sm.btn-outline.pagination-btn#pagination-prev(disabled)
        i.fas.fa-angle-left
      
      .pagination-pages#pagination-pages
        // Pages will be added dynamically
      
      button.btn.btn-sm.btn-outline.pagination-btn#pagination-next(disabled)
        i.fas.fa-angle-right
      
      button.btn.btn-sm.btn-outline.pagination-btn#pagination-last(disabled)
        i.fas.fa-angle-double-right
    
    .pagination-size
      label.pagination-label(for="pagination-size") Items per page:
      select.pagination-select#pagination-size
        option(value="10") 10
        option(value="25" selected) 25
        option(value="50") 50
        option(value="100") 100

  // Detail view modal for selected record
  #record-detail-modal.modal.hidden
    .modal-overlay
    .modal-container
      .modal-header
        h3.modal-title#detail-modal-title Record Details
        button.modal-close#detail-modal-close
          i.fas.fa-times
      .modal-body#detail-modal-content
        // Detail content will be added dynamically
      .modal-footer
        button.btn.btn-outline#detail-modal-close-btn Close

block append styles
  style.
    /* Filtering and actions bar */
    .filter-container {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      padding: var(--space-4);
      background-color: var(--surface-card);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
      box-shadow: var(--shadow-sm);
    }
    
    .filter-section {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    
    .filter-section-search {
      flex: 1;
      min-width: 200px;
    }
    
    .filter-label {
      font-weight: 500;
      color: var(--text-secondary);
      white-space: nowrap;
    }
    
    .filter-select {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      color: var(--text-primary);
      min-width: 150px;
    }
    
    .search-wrapper {
      position: relative;
      width: 100%;
    }
    
    .search-icon {
      position: absolute;
      left: var(--space-3);
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
      pointer-events: none;
    }
    
    .search-input {
      width: 100%;
      padding: var(--space-2) var(--space-2) var(--space-2) calc(var(--space-2) + 24px);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-medium);
      background-color: var(--surface-card);
      color: var(--text-primary);
    }
    
    .search-clear {
      position: absolute;
      right: var(--space-3);
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-tertiary);
      background: none;
      border: none;
      width: 24px;
      height: 24px;
      border-radius: var(--radius-md);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition-fast);
      opacity: 0;
      pointer-events: none;
    }
    
    .search-clear.visible {
      opacity: 1;
      pointer-events: auto;
    }
    
    .search-clear:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
    }
    
    /* Data stats and actions bar */
    .data-stats-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-3) var(--space-4);
      background-color: var(--surface-table-header);
      border: 1px solid var(--border-light);
      border-bottom: none;
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }
    
    .data-stats {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }
    
    .stat-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: var(--font-size-sm);
    }
    
    .stat-label {
      color: var(--text-tertiary);
      font-weight: 500;
    }
    
    .stat-value {
      color: var(--text-primary);
      font-weight: 600;
    }
    
    .data-actions {
      display: flex;
      gap: var(--space-2);
    }
    
    /* Data table container with modified styling */
    .data-table-container {
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
      border: 1px solid var(--border-light);
      border-top: none;
      overflow: hidden;
      margin-bottom: var(--space-4);
    }
    
    .data-table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .data-table th {
      position: sticky;
      top: 0;
      background-color: var(--surface-table-header);
      z-index: 10;
      padding: var(--space-3);
      text-align: left;
      font-weight: 600;
      color: var(--text-secondary);
      font-size: var(--font-size-sm);
      border-bottom: 1px solid var(--border-medium);
      white-space: nowrap;
    }
    
    .data-table th.sortable {
      cursor: pointer;
      padding-right: calc(var(--space-3) + 16px);
      position: relative;
    }
    
    .data-table th.sortable::after {
      content: '\f0dc';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      position: absolute;
      right: var(--space-2);
      color: var(--text-tertiary);
      opacity: 0.5;
    }
    
    .data-table th.sort-asc::after {
      content: '\f0de';
      opacity: 1;
      color: var(--brand-primary);
    }
    
    .data-table th.sort-desc::after {
      content: '\f0dd';
      opacity: 1;
      color: var(--brand-primary);
    }
    
    .data-table td {
      padding: var(--space-3);
      border-bottom: 1px solid var(--border-light);
      font-size: var(--font-size-sm);
      color: var(--text-secondary);
    }
    
    .data-table tbody tr:hover {
      background-color: var(--brand-primary-bg);
    }
    
    .data-table tr.clickable {
      cursor: pointer;
    }
    
    .data-table tr:last-child td {
      border-bottom: none;
    }
    
    .loading-cell {
      text-align: center;
      padding: var(--space-6);
      color: var(--text-tertiary);
    }
    
    .loading-cell i {
      font-size: var(--font-size-xl);
      margin-bottom: var(--space-2);
      display: block;
    }
    
    /* Table pagination */
    .table-pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: var(--space-6);
      padding: var(--space-3) var(--space-4);
    }
    
    .pagination-info {
      font-size: var(--font-size-sm);
      color: var(--text-tertiary);
    }
    
    .pagination-controls {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }
    
    .pagination-btn {
      min-width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    
    .pagination-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .pagination-pages {
      display: flex;
      gap: var(--space-1);
    }
    
    .pagination-page {
      min-width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-md);
      background: transparent;
      border: 1px solid var(--border-light);
      color: var(--text-secondary);
      cursor: pointer;
      font-size: var(--font-size-sm);
      transition: all var(--transition-fast);
    }
    
    .pagination-page:hover {
      background-color: var(--surface-nav-hover);
      border-color: var(--border-medium);
    }
    
    .pagination-page.active {
      background-color: var(--brand-primary);
      border-color: var(--brand-primary);
      color: var(--text-inverse);
    }
    
    .pagination-size {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    
    .pagination-label {
      font-size: var(--font-size-sm);
      color: var(--text-tertiary);
      white-space: nowrap;
    }
    
    .pagination-select {
      padding: var(--space-1) var(--space-2);
      border: 1px solid var(--border-medium);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      color: var(--text-primary);
      background-color: var(--surface-card);
    }
    
    /* Record detail modal */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .modal.hidden {
      display: none;
    }
    
    .modal-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
    }
    
    .modal-container {
      position: relative;
      background-color: var(--surface-card);
      border-radius: var(--radius-lg);
      width: 90%;
      max-width: 600px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-lg);
      z-index: 10;
    }
    
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-4);
      border-bottom: 1px solid var(--border-light);
    }
    
    .modal-title {
      font-size: var(--font-size-lg);
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .modal-close {
      background: none;
      border: none;
      color: var(--text-tertiary);
      width: 32px;
      height: 32px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    
    .modal-close:hover {
      background-color: var(--surface-nav-hover);
      color: var(--text-primary);
    }
    
    .modal-body {
      padding: var(--space-4);
      overflow-y: auto;
      max-height: calc(90vh - 150px);
    }
    
    .modal-footer {
      padding: var(--space-3) var(--space-4);
      display: flex;
      justify-content: flex-end;
      border-top: 1px solid var(--border-light);
    }
    
    /* Detail content styles */
    .detail-content {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    
    .detail-field {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }
    
    .detail-label {
      font-size: var(--font-size-sm);
      font-weight: 600;
      color: var(--text-tertiary);
    }
    
    .detail-value {
      color: var(--text-primary);
      word-break: break-word;
    }
    
    .detail-tabs {
      display: flex;
      border-bottom: 1px solid var(--border-light);
      margin-bottom: var(--space-4);
    }
    
    .detail-tab {
      padding: var(--space-2) var(--space-3);
      cursor: pointer;
      border-bottom: 2px solid transparent;
      color: var(--text-secondary);
      font-weight: 500;
    }
    
    .detail-tab:hover {
      color: var(--text-primary);
    }
    
    .detail-tab.active {
      border-color: var(--brand-primary);
      color: var(--brand-primary);
    }
    
    .detail-panel {
      display: none;
    }
    
    .detail-panel.active {
      display: block;
    }
    
    .related-items {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    
    .related-item {
      padding: var(--space-3);
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      background-color: var(--surface-nav-hover);
      cursor: pointer;
      transition: all var(--transition-fast);
    }
    
    .related-item:hover {
      border-color: var(--brand-primary);
      background-color: var(--brand-primary-bg);
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      .filter-container {
        flex-direction: column;
        gap: var(--space-3);
      }
      
      .filter-section {
        width: 100%;
      }
      
      .filter-select {
        width: 100%;
      }
      
      .data-stats-container {
        flex-direction: column;
        gap: var(--space-3);
        align-items: flex-start;
      }
      
      .table-pagination {
        flex-direction: column;
        gap: var(--space-3);
      }
      
      .pagination-controls {
        order: 1;
      }
      
      .pagination-info {
        order: 3;
      }
      
      .pagination-size {
        order: 2;
      }
    }

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // State management
      const state = {
        table: 'clients',
        dataSource: 'all',
        data: [],
        filteredData: [],
        searchTerm: '',
        currentPage: 1,
        itemsPerPage: 25,
        sortColumn: null,
        sortDirection: 'asc'
      };
      
      // DOM elements
      const tableSelect = document.getElementById('table-select');
      const dataSourceSelect = document.getElementById('data-source-select');
      const tableSearch = document.getElementById('table-search');
      const searchClear = document.getElementById('search-clear');
      const refreshBtn = document.getElementById('btn-refresh');
      const dataTable = document.getElementById('data-table');
      const recordsCount = document.getElementById('records-count');
      const currentSource = document.getElementById('current-source');
      const filterStatus = document.getElementById('filter-status');
      
      // Pagination elements
      const paginationShowing = document.getElementById('pagination-showing');
      const paginationTotal = document.getElementById('pagination-total');
      const paginationFirst = document.getElementById('pagination-first');
      const paginationPrev = document.getElementById('pagination-prev');
      const paginationNext = document.getElementById('pagination-next');
      const paginationLast = document.getElementById('pagination-last');
      const paginationPages = document.getElementById('pagination-pages');
      const paginationSize = document.getElementById('pagination-size');
      
      // Export buttons
      const exportCSVBtn = document.getElementById('btn-export-table-csv');
      const exportJSONBtn = document.getElementById('btn-export-table-json');
      
      // Modal elements
      const detailModal = document.getElementById('record-detail-modal');
      const detailModalTitle = document.getElementById('detail-modal-title');
      const detailModalContent = document.getElementById('detail-modal-content');
      const detailModalClose = document.getElementById('detail-modal-close');
      const detailModalCloseBtn = document.getElementById('detail-modal-close-btn');
      
      // Initialize the data table
      loadTableData();
      
      // Event listeners
      tableSelect.addEventListener('change', () => {
        state.table = tableSelect.value;
        state.currentPage = 1;
        state.sortColumn = null;
        state.sortDirection = 'asc';
        loadTableData();
      });
      
      dataSourceSelect.addEventListener('change', () => {
        state.dataSource = dataSourceSelect.value;
        loadTableData();
      });
      
      tableSearch.addEventListener('input', () => {
        state.searchTerm = tableSearch.value.trim().toLowerCase();
        searchClear.classList.toggle('visible', state.searchTerm !== '');
        filterData();
        renderTable();
        updatePagination();
      });
      
      searchClear.addEventListener('click', () => {
        tableSearch.value = '';
        state.searchTerm = '';
        searchClear.classList.remove('visible');
        filterData();
        renderTable();
        updatePagination();
      });
      
      refreshBtn.addEventListener('click', loadTableData);
      
      paginationFirst.addEventListener('click', () => {
        if (state.currentPage > 1) {
          state.currentPage = 1;
          renderTable();
          updatePagination();
        }
      });
      
      paginationPrev.addEventListener('click', () => {
        if (state.currentPage > 1) {
          state.currentPage--;
          renderTable();
          updatePagination();
        }
      });
      
      paginationNext.addEventListener('click', () => {
        const totalPages = Math.ceil(state.filteredData.length / state.itemsPerPage);
        if (state.currentPage < totalPages) {
          state.currentPage++;
          renderTable();
          updatePagination();
        }
      });
      
      paginationLast.addEventListener('click', () => {
        const totalPages = Math.ceil(state.filteredData.length / state.itemsPerPage);
        if (state.currentPage < totalPages) {
          state.currentPage = totalPages;
          renderTable();
          updatePagination();
        }
      });
      
      paginationSize.addEventListener('change', () => {
        state.itemsPerPage = parseInt(paginationSize.value);
        state.currentPage = 1;
        renderTable();
        updatePagination();
      });
      
      exportCSVBtn.addEventListener('click', exportTableAsCSV);
      exportJSONBtn.addEventListener('click', exportTableAsJSON);
      
      detailModalClose.addEventListener('click', closeDetailModal);
      detailModalCloseBtn.addEventListener('click', closeDetailModal);
      
      // Load table data from API
      async function loadTableData() {
        // Show loading state
        dataTable.innerHTML = `
          <thead>
            <tr>
              <th class="loading-cell">Loading data...</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="loading-cell">
                <i class="fas fa-spinner fa-spin"></i>
                Loading ${state.table} data from ${state.dataSource === 'all' ? 'all sources' : state.dataSource}...
              </td>
            </tr>
          </tbody>
        `;
        
        try {
          // Fetch data from API based on selected table and source
          const response = await fetch(`/api/${state.table}?source=${state.dataSource}`);
          
          if (!response.ok) {
            throw new Error('Failed to load data');
          }
          
          const data = await response.json();
          
          // Store the data
          state.data = data;
          state.filteredData = [...data];
          
          // Update UI
          currentSource.textContent = state.dataSource === 'all' ? 'All Sources' : 
                                     state.dataSource === 'sql' ? 'SQL Database' :
                                     state.dataSource === 'xml' ? 'XML Store' : 'Neo4j Graph';
          
          recordsCount.textContent = data.length;
          filterStatus.textContent = 'None';
          
          // Filter and render data
          filterData();
          renderTable();
          updatePagination();
          
        } catch (error) {
          console.error('Error loading data:', error);
          dataTable.innerHTML = `
            <thead>
              <tr>
                <th class="loading-cell">Error</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="loading-cell">
                  <i class="fas fa-exclamation-triangle"></i>
                  Failed to load data: ${error.message}
                </td>
              </tr>
            </tbody>
          `;
        }
      }
      
      // Filter data based on search term
      function filterData() {
        if (!state.searchTerm) {
          state.filteredData = [...state.data];
          filterStatus.textContent = 'None';
          return;
        }
        
        // Filter by search term across all fields
        state.filteredData = state.data.filter(item => {
          return Object.values(item).some(value => 
            String(value).toLowerCase().includes(state.searchTerm)
          );
        });
        
        filterStatus.textContent = `"${state.searchTerm}" (${state.filteredData.length} matches)`;
      }
      
      // Render table with current data
      function renderTable() {
        if (state.filteredData.length === 0) {
          dataTable.innerHTML = `
            <thead>
              <tr>
                <th class="loading-cell">No results</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="loading-cell">
                  <i class="fas fa-search"></i>
                  No data found matching your criteria
                </td>
              </tr>
            </tbody>
          `;
          return;
        }
        
        // Get column headers from first item
        const columns = Object.keys(state.filteredData[0]);
        
        // Create table header
        let tableHTML = '<thead><tr>';
        
        columns.forEach(column => {
          const sortClass = state.sortColumn === column 
            ? (state.sortDirection === 'asc' ? 'sort-asc' : 'sort-desc')
            : '';
            
          tableHTML += `<th class="sortable ${sortClass}" data-column="${column}">${formatColumnHeader(column)}</th>`;
        });
        
        tableHTML += '</tr></thead>';
        
        // Sort data if needed
        let displayData = [...state.filteredData];
        
        if (state.sortColumn) {
          displayData.sort((a, b) => {
            const aVal = a[state.sortColumn];
            const bVal = b[state.sortColumn];
            
            if (aVal === bVal) return 0;
            
            // Handle null values in sorting
            if (aVal === null) return 1;
            if (bVal === null) return -1;
            
            // Check if values are dates
            const aDate = new Date(aVal);
            const bDate = new Date(bVal);
            
            if (!isNaN(aDate) && !isNaN(bDate)) {
              return state.sortDirection === 'asc' ? aDate - bDate : bDate - aDate;
            }
            
            // Check if values are numbers
            if (!isNaN(aVal) && !isNaN(bVal)) {
              return state.sortDirection === 'asc' ? aVal - bVal : bVal - aVal;
            }
            
            // Default string comparison
            const comparison = String(aVal).localeCompare(String(bVal));
            return state.sortDirection === 'asc' ? comparison : -comparison;
          });
        }
        
        // Paginate data
        const startIndex = (state.currentPage - 1) * state.itemsPerPage;
        const endIndex = Math.min(startIndex + state.itemsPerPage, displayData.length);
        const paginatedData = displayData.slice(startIndex, endIndex);
        
        // Create table rows
        tableHTML += '<tbody>';
        
        paginatedData.forEach(item => {
          tableHTML += '<tr class="clickable" data-id="' + (item.id || item.id_client || item.id_commande || Object.values(item)[0]) + '">';
          
          columns.forEach(column => {
            let value = item[column];
            
            // Format special values
            if (value === null || value === undefined) {
              value = '-';
            } else if (typeof value === 'object') {
              value = JSON.stringify(value);
            } else if (String(value).match(/^\d{4}-\d{2}-\d{2}T/)) {
              // Format ISO dates
              const date = new Date(value);
              value = date.toLocaleString();
            }
            
            tableHTML += `<td>${value}</td>`;
          });
          
          tableHTML += '</tr>';
        });
        
        tableHTML += '</tbody>';
        
        // Update the table
        dataTable.innerHTML = tableHTML;
        
        // Add click handlers for sorting
        const headers = dataTable.querySelectorAll('th.sortable');
        headers.forEach(header => {
          header.addEventListener('click', () => {
            const column = header.getAttribute('data-column');
            
            // Toggle direction if clicking the same column
            if (state.sortColumn === column) {
              state.sortDirection = state.sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
              state.sortColumn = column;
              state.sortDirection = 'asc';
            }
            
            renderTable();
          });
        });
        
        // Add click handlers for row selection
        const rows = dataTable.querySelectorAll('tbody tr.clickable');
        rows.forEach(row => {
          row.addEventListener('click', () => {
            const id = row.getAttribute('data-id');
            const record = paginatedData.find(item => 
              String(item.id || item.id_client || item.id_commande || Object.values(item)[0]) === id
            );
            
            showDetailModal(record);
          });
        });
      }
      
      // Update pagination controls
      function updatePagination() {
        const totalItems = state.filteredData.length;
        const totalPages = Math.ceil(totalItems / state.itemsPerPage);
        
        // Update pagination info
        const startItem = totalItems === 0 ? 0 : (state.currentPage - 1) * state.itemsPerPage + 1;
        const endItem = Math.min(state.currentPage * state.itemsPerPage, totalItems);
        
        paginationShowing.textContent = `${startItem}-${endItem}`;
        paginationTotal.textContent = totalItems;
        
        // Update button states
        paginationFirst.disabled = state.currentPage <= 1;
        paginationPrev.disabled = state.currentPage <= 1;
        paginationNext.disabled = state.currentPage >= totalPages;
        paginationLast.disabled = state.currentPage >= totalPages || totalPages <= 1;
        
        // Generate page buttons
        paginationPages.innerHTML = '';
        
        // Determine which pages to show
        let startPage = Math.max(1, state.currentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        
        // Adjust if we're near the end
        if (endPage - startPage < 4 && startPage > 1) {
          startPage = Math.max(1, endPage - 4);
        }
        
        // Create page buttons
        for (let i = startPage; i <= endPage; i++) {
          const pageBtn = document.createElement('button');
          pageBtn.className = `pagination-page ${i === state.currentPage ? 'active' : ''}`;
          pageBtn.textContent = i;
          
          pageBtn.addEventListener('click', () => {
            if (state.currentPage !== i) {
              state.currentPage = i;
              renderTable();
              updatePagination();
            }
          });
          
          paginationPages.appendChild(pageBtn);
        }
      }
      
      // Show detail modal for a record
      function showDetailModal(record) {
        if (!record) return;
        
        // Set modal title
        detailModalTitle.textContent = `${formatTableName(state.table)} Details`;
        
        // Generate detail content
        let detailHTML = '<div class="detail-content">';
        
        // Create fields for each property
        for (const [key, value] of Object.entries(record)) {
          let displayValue = value;
          
          // Format special values
          if (value === null || value === undefined) {
            displayValue = '<em>Not set</em>';
          } else if (typeof value === 'object') {
            displayValue = `<pre>${JSON.stringify(value, null, 2)}</pre>`;
          } else if (String(value).match(/^\d{4}-\d{2}-\d{2}T/)) {
            // Format ISO dates
            const date = new Date(value);
            displayValue = date.toLocaleString();
          } else if (key.includes('email')) {
            displayValue = `<a href="mailto:${value}" class="link">${value}</a>`;
          }
          
          detailHTML += `
            <div class="detail-field">
              <div class="detail-label">${formatColumnHeader(key)}</div>
              <div class="detail-value">${displayValue}</div>
            </div>
          `;
        }
        
        detailHTML += '</div>';
        
        // Set modal content
        detailModalContent.innerHTML = detailHTML;
        
        // Show modal
        detailModal.classList.remove('hidden');
      }
      
      // Close detail modal
      function closeDetailModal() {
        detailModal.classList.add('hidden');
      }
      
      // Format column header for display
      function formatColumnHeader(column) {
        return column
          .replace(/_/g, ' ')
          .replace(/id/i, 'ID')
          .split(' ')
          .map(word => word.charAt(0).toUpperCase() + word.slice(1))
          .join(' ');
      }
      
      // Format table name for display
      function formatTableName(table) {
        switch(table) {
          case 'clients': return 'Client';
          case 'employees': return 'Employee';
          case 'agences': return 'Agence';
          case 'commandes': return 'Commande';
          case 'details-commande': return 'Details Commande';
          case 'produits': return 'Produit';
          case 'fournisseurs': return 'Fournisseur';
          case 'factures': return 'Facture';
          case 'livraisons': return 'Livraison';
          case 'approvisionnements': return 'Approvisionnement';
          default: return table.charAt(0).toUpperCase() + table.slice(1);
        }
      }
      
      // Export table data as CSV
      function exportTableAsCSV() {
        if (state.filteredData.length === 0) {
          alert('No data to export');
          return;
        }
        
        // Get columns from first record
        const columns = Object.keys(state.filteredData[0]);
        
        // Create CSV header row
        const csvRows = [columns.map(column => `"${column}"`).join(',')];
        
        // Add data rows
        state.filteredData.forEach(item => {
          const values = columns.map(column => {
            const value = item[column];
            
            // Format values for CSV
            if (value === null || value === undefined) {
              return '""';
            } else if (typeof value === 'object') {
              return `"${JSON.stringify(value).replace(/"/g, '""')}"`;
            } else {
              return `"${String(value).replace(/"/g, '""')}"`;
            }
          });
          
          csvRows.push(values.join(','));
        });
        
        // Download the CSV file
        const csvContent = csvRows.join('\n');
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `${state.table}_${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }
      
      // Export table data as JSON
      function exportTableAsJSON() {
        if (state.filteredData.length === 0) {
          alert('No data to export');
          return;
        }
        
        // Download the JSON file
        const jsonContent = JSON.stringify(state.filteredData, null, 2);
        const blob = new Blob([jsonContent], { type: 'application/json;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        
        const link = document.createElement('a');
        link.href = url;
        link.download = `${state.table}_${new Date().toISOString().split('T')[0]}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }
    });