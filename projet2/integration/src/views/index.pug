extends layouts/main

block content
  .page-header
    .page-title-wrapper
      h1.page-title Data Integration Dashboard
      p.page-description Real-time overview of integrated data sources

  // Data source connection status
  .section
    h2.section-title Data Sources
    p.section-description Monitor connection status across all integrated data systems

    .source-grid
      .source-card
        .source-header
          .source-title
            i.fas.fa-database
            | SQL Database
          .source-status
            .status-indicator(class="status-online")
            span Connected
        .source-details MySQL server running the core transactional database (MAGASIN_SQL)
        .source-stats
          .source-stat
            .source-stat-value#sql-clients-count Loading...
            .source-stat-label Clients
          .source-stat
            .source-stat-value#sql-orders-count Loading...
            .source-stat-label Orders
          .source-stat
            .source-stat-value#sql-products-count Loading...
            .source-stat-label Products
          .source-stat
            .source-stat-value#sql-employees-count Loading...
            .source-stat-label Employees
            
      .source-card
        .source-header
          .source-title
            i.fas.fa-file-code
            | XML Store
          .source-status
            .status-indicator(class="status-online")
            span Connected
        .source-details XML document store containing secondary business data
        .source-stats
          .source-stat
            .source-stat-value#xml-clients-count Loading...
            .source-stat-label Clients
          .source-stat
            .source-stat-value#xml-invoices-count Loading...
            .source-stat-label Invoices
          .source-stat
            .source-stat-value#xml-deliveries-count Loading...
            .source-stat-label Deliveries
          .source-stat
            .source-stat-value#xml-suppliers-count Loading...
            .source-stat-label Suppliers
            
      .source-card
        .source-header
          .source-title
            i.fas.fa-project-diagram
            | Neo4j Graph
          .source-status
            .status-indicator(class="status-online")
            span Connected
        .source-details Graph database containing relationship-focused business data
        .source-stats
          .source-stat
            .source-stat-value#neo4j-clients-count Loading...
            .source-stat-label Clients
          .source-stat
            .source-stat-value#neo4j-orders-count Loading...
            .source-stat-label Orders
          .source-stat
            .source-stat-value#neo4j-products-count Loading...
            .source-stat-label Products
          .source-stat
            .source-stat-value#neo4j-relationships-count Loading...
            .source-stat-label Relationships

  // Key Metrics
  .section
    h2.section-title Key Integration Metrics
    p.section-description Overall statistics across all data sources

    .stats-grid
      .stat-card
        .stat-header
          .stat-title TOTAL CLIENTS
          .stat-icon
            i.fas.fa-users
        .stat-value#total-clients-count Loading...
        .stat-description Unique clients across all systems
      
      .stat-card
        .stat-header
          .stat-title TOTAL ORDERS
          .stat-icon
            i.fas.fa-shopping-cart
        .stat-value#total-orders-count Loading...
        .stat-description Combined orders from all sources
      
      .stat-card
        .stat-header
          .stat-title TOTAL PRODUCTS
          .stat-icon
            i.fas.fa-box
        .stat-value#total-products-count Loading...
        .stat-description Complete product catalog
      
      .stat-card
        .stat-header
          .stat-title DATA CONSISTENCY
          .stat-icon
            i.fas.fa-check-circle
        .stat-value#data-consistency Loading...
        .stat-description Cross-reference validation
  
  // Recent Activity
  .section
    h2.section-title Recent Activity
    p.section-description Latest data integration operations

    .data-table-container
      table.data-table#activity-table
        thead
          tr
            th Timestamp
            th Source
            th Operation
            th Status
            th Details
        tbody
          tr.placeholder-row
            td(colspan="5") Loading recent activity...

block append styles
  style.
    /* Dashboard specific styles */
    .dashboard-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: var(--space-6);
    }
    
    .dashboard-actions {
      display: flex;
      gap: var(--space-3);
    }
    
    .btn-with-icon {
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    
    /* Metrics grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: var(--space-5);
      margin-bottom: var(--space-6);
    }
    
    .metric-card {
      position: relative;
      background-color: var(--surface-card);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border-light);
      transition: all var(--transition-fast);
      overflow: hidden;
    }
    
    .metric-card:hover {
      box-shadow: var(--shadow-md);
      border-color: var(--border-medium);
    }
    
    .metric-card::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 6px;
      height: 100%;
      border-top-left-radius: var(--radius-lg);
      border-bottom-left-radius: var(--radius-lg);
    }
    
    .metric-card-clients::after {
      background-color: var(--brand-primary);
    }
    
    .metric-card-orders::after {
      background-color: var(--brand-secondary);
    }
    
    .metric-card-products::after {
      background-color: var(--brand-accent);
    }
    
    .metric-card-employees::after {
      background-color: var(--status-info);
    }
    
    .metric-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-md);
      background-color: var(--brand-primary-bg);
      color: var(--brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      flex-shrink: 0;
    }
    
    .metric-card-orders .metric-icon {
      background-color: rgba(14, 165, 233, 0.1);
      color: var(--brand-secondary);
    }
    
    .metric-card-products .metric-icon {
      background-color: rgba(249, 115, 22, 0.1);
      color: var(--brand-accent);
    }
    
    .metric-card-employees .metric-icon {
      background-color: rgba(59, 130, 246, 0.1);
      color: var(--status-info);
    }
    
    .metric-content {
      flex: 1;
    }
    
    .metric-label {
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--text-tertiary);
      margin-bottom: var(--space-1);
    }
    
    .metric-value {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: var(--space-2);
      line-height: 1.1;
    }
    
    .metric-trend {
      font-size: 0.8125rem;
      display: flex;
      align-items: center;
      gap: var(--space-1);
      font-weight: 500;
    }
    
    .trend-up {
      color: var(--status-success);
    }
    
    .trend-down {
      color: var(--status-error);
    }
    
    .trend-neutral {
      color: var(--text-tertiary);
    }
    
    .metric-chart {
      position: absolute;
      right: 0;
      bottom: 0;
      width: 100px;
      height: 40px;
      opacity: 0.2;
    }
    
    /* Dashboard grid */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      margin-bottom: var(--space-6);
    }
    
    @media (max-width: 1024px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }
    
    /* Data source items */
    .data-sources-grid {
      display: grid;
      gap: var(--space-4);
      margin-bottom: var(--space-5);
    }
    
    .data-source-item {
      display: flex;
      align-items: center;
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background-color: var(--surface-code);
      border: 1px solid var(--border-light);
    }
    
    .data-source-icon {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      background-color: var(--brand-primary-bg);
      color: var(--brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      margin-right: var(--space-4);
    }
    
    .source-xml .data-source-icon {
      background-color: rgba(236, 72, 153, 0.1);
      color: #ec4899;
    }
    
    .source-neo4j .data-source-icon {
      background-color: rgba(16, 185, 129, 0.1);
      color: #10b981;
    }
    
    .data-source-details {
      flex: 1;
    }
    
    .data-source-name {
      font-weight: 600;
      margin-bottom: var(--space-1);
    }
    
    .data-source-stats {
      font-size: 0.875rem;
      color: var(--text-tertiary);
    }
    
    .data-source-status {
      margin-left: auto;
    }
    
    /* System checks */
    .data-system-checks {
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-light);
    }
    
    .system-check-title {
      font-weight: 600;
      margin-bottom: var(--space-3);
    }
    
    .system-check-items {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    
    .system-check-item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.9375rem;
    }
    
    .text-success {
      color: var(--status-success);
    }
    
    .text-warning {
      color: var(--status-warning);
    }
    
    .text-danger {
      color: var(--status-error);
    }
    
    /* Activity timeline */
    .activity-timeline {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    
    .activity-item {
      display: flex;
      gap: var(--space-3);
    }
    
    .activity-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      flex-shrink: 0;
    }
    
    .bg-primary {
      background-color: var(--brand-primary);
    }
    
    .bg-secondary {
      background-color: var(--brand-secondary);
    }
    
    .bg-success {
      background-color: var(--status-success);
    }
    
    .bg-warning {
      background-color: var(--status-warning);
    }
    
    .bg-info {
      background-color: var(--status-info);
    }
    
    .activity-content {
      flex: 1;
    }
    
    .activity-title {
      font-weight: 600;
      margin-bottom: var(--space-1);
    }
    
    .activity-timestamp {
      font-size: 0.75rem;
      color: var(--text-tertiary);
      margin-bottom: var(--space-2);
    }
    
    .activity-description {
      font-size: 0.9375rem;
      color: var(--text-secondary);
    }
    
    /* Quick access grid */
    .quick-access-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--space-4);
    }
    
    .quick-access-item {
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background-color: var(--surface-card);
      border: 1px solid var(--border-light);
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      text-decoration: none;
      color: var(--text-primary);
      transition: all var(--transition-fast);
    }
    
    .quick-access-item:hover {
      background-color: var(--brand-primary-bg);
      border-color: var(--brand-primary-muted);
      transform: translateY(-2px);
    }
    
    .quick-access-icon {
      width: 48px;
      height: 48px;
      border-radius: var(--radius-full);
      background-color: var(--brand-primary-bg);
      color: var(--brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
    }
    
    .quick-access-label {
      font-weight: 500;
    }
    
    /* API Endpoints section */
    .endpoint-section {
      margin-bottom: var(--space-6);
    }
    
    .endpoint-section:last-child {
      margin-bottom: 0;
    }
    
    .endpoint-section-title {
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: var(--space-4);
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: var(--space-2);
    }
    
    .endpoint-search {
      max-width: 250px;
    }
    
    .endpoints-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-3);
    }
    
    .endpoint-item {
      display: flex;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-light);
      overflow: hidden;
      transition: all var(--transition-fast);
    }
    
    .endpoint-item:hover {
      border-color: var(--border-medium);
      box-shadow: var(--shadow-sm);
    }
    
    .endpoint-method {
      padding: var(--space-3);
      background-color: var(--status-info-bg);
      color: var(--status-info);
      font-weight: 600;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 60px;
    }
    
    .endpoint-get .endpoint-method {
      background-color: var(--status-info-bg);
      color: var(--status-info);
    }
    
    .endpoint-post .endpoint-method {
      background-color: var(--status-success-bg);
      color: var(--status-success);
    }
    
    .endpoint-put .endpoint-method {
      background-color: var(--status-warning-bg);
      color: var(--status-warning);
    }
    
    .endpoint-delete .endpoint-method {
      background-color: var(--status-error-bg);
      color: var(--status-error);
    }
    
    .endpoint-content {
      padding: var(--space-3);
      flex: 1;
    }
    
    .endpoint-url {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      color: var(--brand-primary);
      margin-bottom: var(--space-2);
    }
    
    .endpoint-description {
      font-size: 0.8125rem;
      color: var(--text-tertiary);
    }
    
    @media (max-width: 768px) {
      .dashboard-header {
        flex-direction: column;
        gap: var(--space-4);
      }
      
      .dashboard-actions {
        width: 100%;
      }
      
      .endpoints-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Additional dashboard-specific styles */
    .section {
      margin-bottom: var(--space-8);
    }
    
    .section-title {
      font-size: var(--font-size-xl);
      font-weight: 600;
      margin-bottom: var(--space-2);
      color: var(--text-primary);
    }
    
    .section-description {
      margin-bottom: var(--space-4);
      color: var(--text-tertiary);
    }
    
    /* Status badge styling */
    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: var(--space-1) var(--space-2);
      border-radius: var(--radius-md);
      font-size: var(--font-size-xs);
      font-weight: 600;
    }
    
    .status-badge.success {
      background-color: rgba(23, 201, 100, 0.15);
      color: var(--success);
    }
    
    .status-badge.warning {
      background-color: rgba(245, 165, 36, 0.15);
      color: var(--warning);
    }
    
    .status-badge.error {
      background-color: rgba(243, 18, 96, 0.15);
      color: var(--error);
    }
    
    /* Placeholder styling */
    .placeholder-row td {
      text-align: center;
      color: var(--text-tertiary);
      padding: var(--space-4);
    }

block append scripts
  script.
    document.addEventListener('DOMContentLoaded', function() {
      // Endpoint search functionality
      const endpointSearch = document.getElementById('endpoint-search');
      if (endpointSearch) {
        endpointSearch.addEventListener('input', (e) => {
          const searchTerm = e.target.value.toLowerCase();
          
          document.querySelectorAll('.endpoint-item').forEach(item => {
            const endpointUrl = item.querySelector('.endpoint-url').textContent.toLowerCase();
            const endpointDesc = item.querySelector('.endpoint-description').textContent.toLowerCase();
            
            if (endpointUrl.includes(searchTerm) || endpointDesc.includes(searchTerm)) {
              item.style.display = '';
            } else {
              item.style.display = 'none';
            }
          });
        });
      }
      
      // Simulate mini charts in metric cards
      document.querySelectorAll('.metric-chart').forEach(chartContainer => {
        // This would be replaced with actual chart rendering code
        // For demonstration purposes we'll just add a visual indicator
        const chartSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        chartSvg.setAttribute('width', '100');
        chartSvg.setAttribute('height', '40');
        chartSvg.setAttribute('viewBox', '0 0 100 40');
        chartSvg.style.position = 'absolute';
        chartSvg.style.bottom = '0';
        chartSvg.style.right = '0';
        
        // Create a random sparkline path
        const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        let pathData = 'M0,30 ';
        
        for (let i = 1; i < 10; i++) {
          const x = i * 10;
          const y = 10 + Math.random() * 20;
          pathData += `L${x},${y} `;
        }
        
        pathData += 'L100,20';
        path.setAttribute('d', pathData);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', 'currentColor');
        path.setAttribute('stroke-width', '2');
        
        chartSvg.appendChild(path);
        chartContainer.appendChild(chartSvg);
      });
    });

    // Fetch and populate data source stats
    async function fetchDataSourceStats() {
      try {
        // Get statistics from API
        const response = await fetch('/api/statistics');
        const stats = await response.json();
        
        // Update SQL stats
        document.getElementById('sql-clients-count').textContent = stats.sql?.clients || '0';
        document.getElementById('sql-orders-count').textContent = stats.sql?.commandes || '0';
        document.getElementById('sql-products-count').textContent = stats.sql?.produits || '0';
        document.getElementById('sql-employees-count').textContent = stats.sql?.employees || '0';
        
        // Update XML stats
        document.getElementById('xml-clients-count').textContent = stats.xml?.clients || '0';
        document.getElementById('xml-invoices-count').textContent = stats.xml?.factures || '0';
        document.getElementById('xml-deliveries-count').textContent = stats.xml?.livraisons || '0';
        document.getElementById('xml-suppliers-count').textContent = stats.xml?.fournisseurs || '0';
        
        // Update Neo4j stats
        document.getElementById('neo4j-clients-count').textContent = stats.neo4j?.clients || '0';
        document.getElementById('neo4j-orders-count').textContent = stats.neo4j?.commandes || '0';
        document.getElementById('neo4j-products-count').textContent = stats.neo4j?.produits || '0';
        document.getElementById('neo4j-relationships-count').textContent = stats.neo4j?.relationships || '0';
        
        // Update total metrics
        document.getElementById('total-clients-count').textContent = stats.totals?.clients || '0';
        document.getElementById('total-orders-count').textContent = stats.totals?.commandes || '0';
        document.getElementById('total-products-count').textContent = stats.totals?.produits || '0';
        
        // Update consistency status
        const consistencyElement = document.getElementById('data-consistency');
        const consistencyValue = stats.consistency?.percentage || 0;
        consistencyElement.textContent = `${consistencyValue}%`;
        
        if (consistencyValue >= 95) {
          consistencyElement.style.color = 'var(--success)';
        } else if (consistencyValue >= 80) {
          consistencyElement.style.color = 'var(--warning)';
        } else {
          consistencyElement.style.color = 'var(--error)';
        }
        
      } catch (error) {
        console.error('Error fetching data source statistics:', error);
      }
    }
    
    // Check health status of connections
    async function checkConnectionHealth() {
      try {
        const response = await fetch('/health');
        const health = await response.json();
        
        // Update connection status indicators
        const sources = ['sql', 'xml', 'neo4j'];
        
        sources.forEach(source => {
          const statusElements = document.querySelectorAll(`.source-card:nth-child(${sources.indexOf(source) + 1}) .status-indicator`);
          const statusTextElements = document.querySelectorAll(`.source-card:nth-child(${sources.indexOf(source) + 1}) .source-status span`);
          
          statusElements.forEach(el => {
            el.classList.toggle('status-online', health.connections[source]);
            el.classList.toggle('status-offline', !health.connections[source]);
          });
          
          statusTextElements.forEach(el => {
            el.textContent = health.connections[source] ? 'Connected' : 'Disconnected';
          });
        });
        
      } catch (error) {
        console.error('Error checking connection health:', error);
      }
    }
    
    // Simulated recent activity data for demonstration
    function loadRecentActivity() {
      const activityData = [
        { timestamp: '2025-04-29 10:23:45', source: 'SQL', operation: 'Data Sync', status: 'Success', details: 'Synchronized 15 new orders' },
        { timestamp: '2025-04-29 10:15:32', source: 'XML', operation: 'Import', status: 'Success', details: 'Imported 7 new invoices' },
        { timestamp: '2025-04-29 09:58:21', source: 'Neo4j', operation: 'Relationship Update', status: 'Success', details: 'Updated client relationships' },
        { timestamp: '2025-04-29 09:45:18', source: 'SQL', operation: 'Query', status: 'Success', details: 'Complex join query executed' },
        { timestamp: '2025-04-29 09:30:05', source: 'XML', operation: 'Validation', status: 'Warning', details: 'Schema validation warnings' }
      ];
      
      const table = document.getElementById('activity-table');
      const tbody = table.querySelector('tbody');
      tbody.innerHTML = '';
      
      activityData.forEach(activity => {
        const row = document.createElement('tr');
        
        const timestampCell = document.createElement('td');
        timestampCell.textContent = activity.timestamp;
        row.appendChild(timestampCell);
        
        const sourceCell = document.createElement('td');
        let sourceIcon = '';
        if (activity.source === 'SQL') sourceIcon = '<i class="fas fa-database"></i> ';
        if (activity.source === 'XML') sourceIcon = '<i class="fas fa-file-code"></i> ';
        if (activity.source === 'Neo4j') sourceIcon = '<i class="fas fa-project-diagram"></i> ';
        sourceCell.innerHTML = sourceIcon + activity.source;
        row.appendChild(sourceCell);
        
        const operationCell = document.createElement('td');
        operationCell.textContent = activity.operation;
        row.appendChild(operationCell);
        
        const statusCell = document.createElement('td');
        if (activity.status === 'Success') {
          statusCell.innerHTML = '<span class="status-badge success"><i class="fas fa-check-circle"></i> Success</span>';
        } else if (activity.status === 'Warning') {
          statusCell.innerHTML = '<span class="status-badge warning"><i class="fas fa-exclamation-triangle"></i> Warning</span>';
        } else {
          statusCell.innerHTML = '<span class="status-badge error"><i class="fas fa-times-circle"></i> Error</span>';
        }
        row.appendChild(statusCell);
        
        const detailsCell = document.createElement('td');
        detailsCell.textContent = activity.details;
        row.appendChild(detailsCell);
        
        tbody.appendChild(row);
      });
    }
    
    // Initialize dashboard
    document.addEventListener('DOMContentLoaded', () => {
      fetchDataSourceStats();
      checkConnectionHealth();
      loadRecentActivity();
      
      // Refresh data every 30 seconds
      setInterval(fetchDataSourceStats, 30000);
      setInterval(checkConnectionHealth, 30000);
    });