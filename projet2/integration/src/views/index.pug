extends layouts/main

block content
  .header
    h1 Data Integration System
    p Seamlessly access and query data from multiple sources through our unified API

  .sql-interface
    h2
      i.fas.fa-database.mr-2
      |  SQL Query Interface
    p Execute powerful SQL queries directly against our integrated global schema
    a.btn(href="/sql-interface")
      i.fas.fa-code
      |  Open SQL Query Interface

  .card
    h2
      i.fas.fa-book.mr-2
      |  API Documentation
    p.mb-4 Use these REST endpoints to access integrated data from all sources:
    
    .endpoints
      h3
        i.fas.fa-list.mr-2
        |  Resource Endpoints
      ul.endpoint-list
        li.endpoint-item
          code.get GET /api/clients
          p Get all clients
        li.endpoint-item
          code.get GET /api/employees
          p Get all employees
        li.endpoint-item
          code.get GET /api/agences
          p Get all agencies
        li.endpoint-item
          code.get GET /api/fournisseurs
          p Get all suppliers
        li.endpoint-item
          code.get GET /api/produits
          p Get all products
        li.endpoint-item
          code.get GET /api/commandes
          p Get all orders
        li.endpoint-item
          code.get GET /api/details-commande
          p Get all order details
    
    .endpoints
      h3
        i.fas.fa-search.mr-2
        |  Search & Filter Endpoints
      ul.endpoint-list
        li.endpoint-item
          code.get GET /api/search/clients?q=query
          p Search clients by name
        li.endpoint-item
          code.get GET /api/clients/{clientId}/commandes
          p Get orders for a specific client
        li.endpoint-item
          code.get GET /api/commandes/{orderId}/details
          p Get details for a specific order
    
    .endpoints
      h3
        i.fas.fa-chart-bar.mr-2
        |  Analytics & Validation Endpoints
      ul.endpoint-list
        li.endpoint-item
          code.get GET /api/statistics
          p Get data statistics across sources
        li.endpoint-item
          code.get GET /api/validate
          p Validate data consistency
        li.endpoint-item
          code.get GET /api/duplicates/clients
          p Find potential duplicate clients
        li.endpoint-item
          code.post POST /api/query
          p Execute a custom query
          
  .card
    h3
      i.fas.fa-code.mr-2
      |  Example Usage
    pre.code-example
      code.
        // Example: Fetching all clients
        fetch('/api/clients')
          .then(response => response.json())
          .then(data => console.log(data))
          .catch(error => console.error('Error:', error));