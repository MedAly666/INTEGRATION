extends layouts/main

block content
  h1 Data Integration System API
  p Welcome to the Data Integration System API. Use the endpoints below to access integrated data:
  
  .sql-interface
    h2 SQL Query Interface
    p Execute SQL queries directly against the integrated global schema:
    a(href="/sql-interface") Open SQL Query Interface
  
  .endpoints
    h2 Available REST Endpoints:
    ul
      li
        code GET /api/clients
        |  - Get all clients
      li
        code GET /api/employees
        |  - Get all employees
      li
        code GET /api/agences
        |  - Get all agencies
      li
        code GET /api/fournisseurs
        |  - Get all suppliers
      li
        code GET /api/produits
        |  - Get all products
      li
        code GET /api/commandes
        |  - Get all orders
      li
        code GET /api/details-commande
        |  - Get all order details
      li
        code GET /api/search/clients?q=query
        |  - Search clients by name
      li
        code GET /api/clients/{clientId}/commandes
        |  - Get orders for a client
      li
        code GET /api/commandes/{orderId}/details
        |  - Get details for an order
      li
        code GET /api/statistics
        |  - Get data statistics
      li
        code GET /api/validate
        |  - Validate data consistency
      li
        code GET /api/duplicates/clients
        |  - Find potential duplicate clients
      li
        code POST /api/query
        |  - Execute a custom query